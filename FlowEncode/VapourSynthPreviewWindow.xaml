<Window
    x:Class="FlowEncode.VapourSynthPreviewWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:FlowEncode"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid
        x:Name="RootLayout"
        AllowDrop="True"
        Background="{ThemeResource WindowBackgroundBrush}"
        DragOver="RootLayout_DragOver"
        Drop="RootLayout_Drop">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid
            Grid.Row="0"
            Margin="8"
            ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="PropsColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <Grid
                x:Name="PreviewViewportHost"
                Grid.Column="0"
                Background="{ThemeResource WindowBackgroundBrush}"
                SizeChanged="PreviewViewportHost_SizeChanged">
                <ScrollViewer
                    x:Name="PreviewScrollViewer"
                    HorizontalScrollBarVisibility="Hidden"
                    IsTabStop="False"
                    PointerCanceled="PreviewScrollViewer_PointerCanceled"
                    PointerCaptureLost="PreviewScrollViewer_PointerCaptureLost"
                    PointerMoved="PreviewScrollViewer_PointerMoved"
                    PointerPressed="PreviewScrollViewer_PointerPressed"
                    PointerReleased="PreviewScrollViewer_PointerReleased"
                    PointerWheelChanged="PreviewScrollViewer_PointerWheelChanged"
                    VerticalScrollBarVisibility="Hidden"
                    ViewChanged="PreviewScrollViewer_ViewChanged"
                    Visibility="{Binding SingleViewportVisibility}">
                    <Grid
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                        <ContentControl
                            x:Name="PreviewImageHost"
                            Height="{Binding PreviewImageHeight}"
                            HorizontalAlignment="Center"
                            IsTabStop="True"
                            KeyDown="PreviewImageHost_KeyDown"
                            Background="Transparent"
                            VerticalAlignment="Center"
                            Width="{Binding PreviewImageWidth}" />
                    </Grid>
                </ScrollViewer>

                <Grid
                    x:Name="WipeOverlayLayer"
                    Visibility="{Binding WipeOverlayVisibility}">
                    <Border
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Margin="10"
                        Padding="8,4"
                        Background="#B8121212"
                        BorderBrush="#55FFFFFF"
                        BorderThickness="1"
                        CornerRadius="4"
                        IsHitTestVisible="False">
                        <TextBlock
                            FontSize="12"
                            Foreground="White"
                            Text="{Binding CompareOutputABadgeText}" />
                    </Border>
                    <Border
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="10"
                        Padding="8,4"
                        Background="#B8121212"
                        BorderBrush="#55FFFFFF"
                        BorderThickness="1"
                        CornerRadius="4"
                        IsHitTestVisible="False">
                        <TextBlock
                            FontSize="12"
                            Foreground="White"
                            Text="{Binding CompareOutputBBadgeText}" />
                    </Border>
                    <local:WipeHandleGrid
                        x:Name="WipeDividerHandle"
                        Width="24"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Stretch"
                        Background="Transparent"
                        DoubleTapped="WipeDividerHandle_DoubleTapped"
                        PointerCanceled="WipeDividerHandle_PointerCanceled"
                        PointerCaptureLost="WipeDividerHandle_PointerCaptureLost"
                        PointerMoved="WipeDividerHandle_PointerMoved"
                        PointerPressed="WipeDividerHandle_PointerPressed"
                        PointerReleased="WipeDividerHandle_PointerReleased">
                        <local:WipeHandleGrid.RenderTransform>
                            <TranslateTransform x:Name="WipeDividerTransform" />
                        </local:WipeHandleGrid.RenderTransform>
                        <Border
                            Width="4"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Stretch"
                            Background="#88000000"
                            IsHitTestVisible="False" />
                        <Border
                            Width="2"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Stretch"
                            Background="#F2FFFFFF"
                            IsHitTestVisible="False" />
                        <Border
                            Width="24"
                            Height="28"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="#DD1A1A1A"
                            BorderBrush="#EEFFFFFF"
                            BorderThickness="1.5"
                            CornerRadius="12"
                            IsHitTestVisible="False">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="White"
                                Text="‹›" />
                        </Border>
                    </local:WipeHandleGrid>
                </Grid>

                <Grid
                    x:Name="SideBySideViewportGrid"
                    Visibility="{Binding SideBySideViewportVisibility}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <ScrollViewer
                            x:Name="LeftCompareScrollViewer"
                            HorizontalScrollBarVisibility="Hidden"
                            IsTabStop="False"
                            PointerCanceled="PreviewScrollViewer_PointerCanceled"
                            PointerCaptureLost="PreviewScrollViewer_PointerCaptureLost"
                            PointerMoved="PreviewScrollViewer_PointerMoved"
                            PointerPressed="PreviewScrollViewer_PointerPressed"
                            PointerReleased="PreviewScrollViewer_PointerReleased"
                            PointerWheelChanged="PreviewScrollViewer_PointerWheelChanged"
                            VerticalScrollBarVisibility="Hidden"
                            ViewChanged="CompareScrollViewer_ViewChanged">
                            <Grid
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                                <ContentControl
                                    x:Name="LeftCompareImageHost"
                                    Height="{Binding PreviewImageHeight}"
                                    HorizontalAlignment="Center"
                                    IsTabStop="True"
                                    KeyDown="PreviewImageHost_KeyDown"
                                    Background="Transparent"
                                    VerticalAlignment="Center"
                                    Width="{Binding PreviewImageWidth}" />
                            </Grid>
                        </ScrollViewer>
                        <Border
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Margin="10"
                            Padding="8,4"
                            Background="#B8121212"
                            BorderBrush="#55FFFFFF"
                            BorderThickness="1"
                            CornerRadius="4"
                            IsHitTestVisible="False">
                            <TextBlock
                                FontSize="12"
                                Foreground="White"
                                Text="{Binding CompareOutputABadgeText}" />
                        </Border>
                    </Grid>

                    <Border
                        Grid.Column="1"
                        Width="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Stretch"
                        Background="{ThemeResource CardBorderBrush}" />

                    <Grid Grid.Column="2">
                        <ScrollViewer
                            x:Name="RightCompareScrollViewer"
                            HorizontalScrollBarVisibility="Hidden"
                            IsTabStop="False"
                            PointerCanceled="PreviewScrollViewer_PointerCanceled"
                            PointerCaptureLost="PreviewScrollViewer_PointerCaptureLost"
                            PointerMoved="PreviewScrollViewer_PointerMoved"
                            PointerPressed="PreviewScrollViewer_PointerPressed"
                            PointerReleased="PreviewScrollViewer_PointerReleased"
                            PointerWheelChanged="PreviewScrollViewer_PointerWheelChanged"
                            VerticalScrollBarVisibility="Hidden"
                            ViewChanged="CompareScrollViewer_ViewChanged">
                            <Grid
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                                <ContentControl
                                    x:Name="RightCompareImageHost"
                                    Height="{Binding SecondaryPreviewImageHeight}"
                                    HorizontalAlignment="Center"
                                    IsTabStop="True"
                                    KeyDown="PreviewImageHost_KeyDown"
                                    Background="Transparent"
                                    VerticalAlignment="Center"
                                    Width="{Binding SecondaryPreviewImageWidth}" />
                            </Grid>
                        </ScrollViewer>
                        <Border
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Margin="10"
                            Padding="8,4"
                            Background="#B8121212"
                            BorderBrush="#55FFFFFF"
                            BorderThickness="1"
                            CornerRadius="4"
                            IsHitTestVisible="False">
                            <TextBlock
                                FontSize="12"
                                Foreground="White"
                                Text="{Binding CompareOutputBBadgeText}" />
                        </Border>
                    </Grid>
                </Grid>

                <Border
                    x:Name="ActiveFlipBadge"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Margin="10"
                    Padding="10,4"
                    Background="#CC121212"
                    BorderBrush="#66FFFFFF"
                    BorderThickness="1"
                    CornerRadius="4"
                    IsHitTestVisible="False"
                    Visibility="{Binding ActiveFlipBadgeVisibility}">
                    <TextBlock
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="White"
                        Text="{Binding ActiveFlipBadgeText}" />
                </Border>

                <Border
                    x:Name="HdrToneMapBanner"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="12,10,12,0"
                    Padding="12,6"
                    Background="#E61E1E1E"
                    BorderBrush="#55FFFFFF"
                    BorderThickness="1"
                    CornerRadius="6"
                    Visibility="{Binding HdrBannerVisibility}">
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <TextBlock
                            FontSize="12"
                            Foreground="White"
                            Text="{Binding HdrBannerText}"
                            VerticalAlignment="Center" />
                        <Button
                            x:Name="EnableHdrToneMapBannerButton"
                            Click="EnableHdrToneMapBannerButton_Click"
                            Padding="10,3"
                            Content="{Binding Texts.VapourSynthPreviewHdrBannerEnableButton}"
                            VerticalAlignment="Center" />
                        <Button
                            x:Name="DismissHdrToneMapBannerButton"
                            Click="DismissHdrToneMapBannerButton_Click"
                            Padding="8,3"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="#CCFFFFFF"
                            Content="{Binding Texts.VapourSynthPreviewHdrBannerDismissButton}"
                            VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <Border
                    x:Name="PipetteOverlayBorder"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    Margin="10"
                    Padding="10,6"
                    Background="#D8121418"
                    BorderBrush="#66FFFFFF"
                    BorderThickness="1"
                    CornerRadius="6"
                    IsHitTestVisible="False"
                    Visibility="{Binding PipetteOverlayVisibility}">
                    <TextBlock
                        FontFamily="{StaticResource AppMonoFont}"
                        FontSize="12"
                        Foreground="White"
                        Text="{Binding PipetteReadoutText}"
                        TextWrapping="Wrap" />
                </Border>
            </Grid>

            <Border
                x:Name="FramePropsPanel"
                Grid.Column="1"
                Padding="10"
                Background="{ThemeResource CardBrush}"
                BorderBrush="{ThemeResource CardBorderBrush}"
                BorderThickness="{StaticResource AppCardBorderThickness}"
                CornerRadius="{StaticResource AppCardCornerRadius}"
                Visibility="Collapsed">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ToggleButton
                            x:Name="InspectorPropsTabButton"
                            Click="InspectorPropsTabButton_Click"
                            Content="{Binding Texts.VapourSynthPreviewInspectorTabProps}"
                            FontSize="12"
                            HorizontalAlignment="Stretch"
                            IsChecked="{Binding IsPropsTabActive, Mode=OneWay}"
                            Padding="2,4" />
                        <ToggleButton
                            x:Name="InspectorScopesTabButton"
                            Grid.Column="1"
                            Click="InspectorScopesTabButton_Click"
                            Content="{Binding Texts.VapourSynthPreviewInspectorTabScopes}"
                            FontSize="12"
                            HorizontalAlignment="Stretch"
                            IsChecked="{Binding IsScopesTabActive, Mode=OneWay}"
                            Padding="2,4" />
                        <ToggleButton
                            x:Name="InspectorBasketTabButton"
                            Grid.Column="2"
                            Click="InspectorBasketTabButton_Click"
                            Content="{Binding Texts.VapourSynthPreviewInspectorTabBasket}"
                            FontSize="12"
                            HorizontalAlignment="Stretch"
                            IsChecked="{Binding IsBasketTabActive, Mode=OneWay}"
                            Padding="2,4" />
                        <ToggleButton
                            x:Name="InspectorWorstTabButton"
                            Grid.Column="3"
                            Click="InspectorWorstTabButton_Click"
                            Content="{Binding Texts.VapourSynthPreviewInspectorTabWorst}"
                            FontSize="12"
                            HorizontalAlignment="Stretch"
                            IsChecked="{Binding IsWorstTabActive, Mode=OneWay}"
                            Padding="2,4" />
                        <ToggleButton
                            x:Name="InspectorScenesTabButton"
                            Grid.Column="4"
                            Click="InspectorScenesTabButton_Click"
                            Content="{Binding Texts.VapourSynthPreviewInspectorTabScenes}"
                            FontSize="12"
                            HorizontalAlignment="Stretch"
                            IsChecked="{Binding IsScenesTabActive, Mode=OneWay}"
                            Padding="2,4" />
                    </Grid>

                    <Grid
                        Grid.Row="1"
                        RowSpacing="8"
                        Visibility="{Binding InspectorPropsVisibility}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border
                            Padding="8,6"
                            Background="{ThemeResource CardAltBrush}"
                            BorderBrush="{ThemeResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Visibility="{Binding PipetteDetailVisibility}">
                            <TextBlock
                                FontFamily="{StaticResource AppMonoFont}"
                                FontSize="11.5"
                                IsTextSelectionEnabled="True"
                                Text="{Binding PipetteDetailText}"
                                TextWrapping="Wrap" />
                        </Border>

                        <TextBox
                            Grid.Row="1"
                            AcceptsReturn="True"
                            Background="Transparent"
                            BorderThickness="0"
                            FontFamily="{StaticResource AppMonoFont}"
                            IsReadOnly="True"
                            ScrollViewer.HorizontalScrollBarVisibility="Auto"
                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                            Text="{Binding FramePropsText}"
                            TextWrapping="NoWrap" />
                    </Grid>

                    <Grid
                        Grid.Row="1"
                        RowSpacing="8"
                        Visibility="{Binding InspectorScopesVisibility}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="220" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button
                                x:Name="ScopeHistogramButton"
                                Click="ScopeModeButton_Click"
                                Content="{Binding Texts.VapourSynthPreviewScopeHistogram}"
                                HorizontalAlignment="Stretch"
                                Padding="4,4"
                                Tag="histogram" />
                            <Button
                                x:Name="ScopeWaveformButton"
                                Grid.Column="1"
                                Click="ScopeModeButton_Click"
                                Content="{Binding Texts.VapourSynthPreviewScopeWaveform}"
                                HorizontalAlignment="Stretch"
                                Padding="4,4"
                                Tag="waveform" />
                            <Button
                                x:Name="ScopeVectorscopeButton"
                                Grid.Column="2"
                                Click="ScopeModeButton_Click"
                                Content="{Binding Texts.VapourSynthPreviewScopeVectorscope}"
                                HorizontalAlignment="Stretch"
                                Padding="4,4"
                                Tag="vectorscope" />
                        </Grid>

                        <Grid
                            Grid.Row="1"
                            ColumnSpacing="4"
                            Visibility="{Binding CompareBarVisibility}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ToggleButton
                                x:Name="ScopeSourceAButton"
                                Click="ScopeSourceButton_Click"
                                Content="{Binding Texts.VapourSynthPreviewScopeSourceA}"
                                HorizontalAlignment="Stretch"
                                IsChecked="True"
                                Padding="4,3"
                                Tag="A" />
                            <ToggleButton
                                x:Name="ScopeSourceBButton"
                                Grid.Column="1"
                                Click="ScopeSourceButton_Click"
                                Content="{Binding Texts.VapourSynthPreviewScopeSourceB}"
                                HorizontalAlignment="Stretch"
                                IsChecked="False"
                                Padding="4,3"
                                Tag="B" />
                        </Grid>

                        <Border
                            Grid.Row="2"
                            BorderBrush="{ThemeResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Background="#FF101216">
                            <canvas:CanvasControl
                                x:Name="ScopeCanvas"
                                Draw="ScopeCanvas_Draw" />
                        </Border>

                        <TextBlock
                            Grid.Row="3"
                            FontSize="11.5"
                            Foreground="{ThemeResource SubtleTextBrush}"
                            Text="{Binding Texts.VapourSynthPreviewScopeHint}"
                            TextWrapping="Wrap" />
                    </Grid>

                    <Grid
                        Grid.Row="1"
                        RowSpacing="8"
                        Visibility="{Binding InspectorBasketVisibility}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button
                                x:Name="BasketAddCurrentButton"
                                Click="BasketAddCurrentButton_Click"
                                Content="{Binding Texts.VapourSynthPreviewBasketAddCurrentButton}"
                                HorizontalAlignment="Stretch"
                                Padding="6,4" />
                            <Button
                                x:Name="BasketSampleFramesButton"
                                Grid.Column="1"
                                Click="BasketSampleFramesButton_Click"
                                Content="{Binding Texts.VapourSynthPreviewBasketSampleButton}"
                                HorizontalAlignment="Stretch"
                                Padding="6,4" />
                            <Button
                                x:Name="BasketClearButton"
                                Grid.Column="2"
                                Click="BasketClearButton_Click"
                                Content="{Binding Texts.VapourSynthPreviewBasketClearButton}"
                                IsEnabled="{Binding CanExportBasket}"
                                Padding="8,4" />
                        </Grid>

                        <Grid Grid.Row="1">
                            <ListView
                                x:Name="BasketFramesListView"
                                IsItemClickEnabled="True"
                                ItemClick="BasketFramesListView_ItemClick"
                                ItemsSource="{Binding BookmarkedFrames}"
                                SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnSpacing="6" Padding="2,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock FontFamily="{StaticResource AppMonoFont}" FontSize="12" Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock FontSize="11" Foreground="{ThemeResource SubtleTextBrush}" Text="{Binding Timecode}" />
                                            </StackPanel>
                                            <Button
                                                Grid.Column="1"
                                                Click="BasketRemoveItemButton_Click"
                                                Content="×"
                                                Padding="6,2"
                                                Tag="{Binding FrameNumber}"
                                                VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="{ThemeResource SubtleTextBrush}"
                                Padding="8"
                                Text="{Binding Texts.VapourSynthPreviewBasketEmptyHint}"
                                TextAlignment="Center"
                                TextWrapping="Wrap"
                                Visibility="{Binding BasketEmptyVisibility}" />
                        </Grid>

                        <TextBlock
                            Grid.Row="2"
                            FontSize="11.5"
                            Foreground="{ThemeResource SubtleTextBrush}"
                            Text="{Binding BasketModeHintText}"
                            TextWrapping="Wrap" />

                        <StackPanel Grid.Row="3" Spacing="6">
                            <Button
                                x:Name="ExportOfflineHtmlButton"
                                Click="ExportOfflineHtmlButton_Click"
                                Content="{Binding Texts.VapourSynthPreviewExportHtmlButton}"
                                HorizontalAlignment="Stretch"
                                IsEnabled="{Binding CanExportBasket}" />
                            <Button
                                x:Name="UploadSlowPicsButton"
                                Click="UploadSlowPicsButton_Click"
                                Content="{Binding Texts.VapourSynthPreviewUploadSlowPicsButton}"
                                HorizontalAlignment="Stretch"
                                IsEnabled="{Binding CanExportBasket}" />
                        </StackPanel>

                        <TextBlock
                            Grid.Row="4"
                            FontSize="11.5"
                            Foreground="{ThemeResource SubtleTextBrush}"
                            IsTextSelectionEnabled="True"
                            Text="{Binding BasketStatusText}"
                            TextWrapping="Wrap"
                            Visibility="{Binding BasketStatusVisibility}" />
                    </Grid>

                    <Grid
                        Grid.Row="1"
                        RowSpacing="8"
                        Visibility="{Binding InspectorWorstVisibility}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ComboBox
                                x:Name="WorstSkipComboBox"
                                DisplayMemberPath="Label"
                                Header="{Binding Texts.VapourSynthPreviewWorstSkipHeader}"
                                HorizontalAlignment="Stretch"
                                ItemsSource="{Binding WorstSkipOptions}"
                                SelectedItem="{Binding SelectedWorstSkipOption, Mode=TwoWay}" />
                            <ComboBox
                                x:Name="WorstSampleComboBox"
                                Grid.Column="1"
                                DisplayMemberPath="Label"
                                Header="{Binding Texts.VapourSynthPreviewWorstSamplesHeader}"
                                HorizontalAlignment="Stretch"
                                ItemsSource="{Binding WorstSampleOptions}"
                                SelectedItem="{Binding SelectedWorstSampleOption, Mode=TwoWay}" />
                            <ComboBox
                                x:Name="WorstMetricComboBox"
                                Grid.Column="2"
                                DisplayMemberPath="Label"
                                Header="{Binding Texts.VapourSynthPreviewWorstMetricHeader}"
                                HorizontalAlignment="Stretch"
                                ItemsSource="{Binding WorstMetricOptions}"
                                SelectedItem="{Binding SelectedWorstMetricOption, Mode=TwoWay}" />
                        </Grid>

                        <Button
                            x:Name="StartWorstScanButton"
                            Grid.Row="1"
                            Click="StartWorstScanButton_Click"
                            Content="{Binding Texts.VapourSynthPreviewWorstStartButton}"
                            HorizontalAlignment="Stretch"
                            IsEnabled="{Binding CanStartWorstScan}" />

                        <TextBlock
                            Grid.Row="2"
                            FontSize="11.5"
                            Foreground="{ThemeResource SubtleTextBrush}"
                            Text="{Binding WorstScanStatusText}"
                            TextWrapping="Wrap"
                            Visibility="{Binding WorstScanStatusVisibility}" />

                        <Grid Grid.Row="3">
                            <ListView
                                x:Name="WorstFramesListView"
                                IsItemClickEnabled="True"
                                ItemClick="WorstFramesListView_ItemClick"
                                ItemsSource="{Binding WorstFrameResults}"
                                SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnSpacing="8" Padding="2,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock FontFamily="{StaticResource AppMonoFont}" FontSize="12" Text="{Binding Timecode}" />
                                                <TextBlock FontSize="11" Foreground="{ThemeResource SubtleTextBrush}" Text="{Binding FrameNumber}" />
                                            </StackPanel>
                                            <TextBlock
                                                Grid.Column="1"
                                                FontFamily="{StaticResource AppMonoFont}"
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                Text="{Binding ScoreLabel}"
                                                VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="{ThemeResource SubtleTextBrush}"
                                Padding="8"
                                Text="{Binding Texts.VapourSynthPreviewWorstIdleHint}"
                                TextAlignment="Center"
                                TextWrapping="Wrap"
                                Visibility="{Binding WorstResultsEmptyVisibility}" />
                        </Grid>

                        <Button
                            x:Name="SendWorstToBasketButton"
                            Grid.Row="4"
                            Click="SendWorstToBasketButton_Click"
                            Content="{Binding Texts.VapourSynthPreviewWorstSendToBasketButton}"
                            HorizontalAlignment="Stretch"
                            IsEnabled="{Binding HasWorstScanResults}" />
                    </Grid>

                    <Grid
                        Grid.Row="1"
                        RowSpacing="8"
                        Visibility="{Binding InspectorScenesVisibility}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button
                                x:Name="SceneMarkInButton"
                                Click="SceneMarkInButton_Click"
                                Content="{Binding Texts.VapourSynthPreviewSceneMarkInButton}"
                                HorizontalAlignment="Stretch"
                                Padding="6,4" />
                            <Button
                                x:Name="SceneMarkOutButton"
                                Grid.Column="1"
                                Click="SceneMarkOutButton_Click"
                                Content="{Binding Texts.VapourSynthPreviewSceneMarkOutButton}"
                                HorizontalAlignment="Stretch"
                                Padding="6,4" />
                            <Button
