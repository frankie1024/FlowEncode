<Window
    x:Class="FlowEncode.VapourSynthPreviewWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid
        x:Name="RootLayout"
        Background="{ThemeResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Preview viewport -->
        <Grid
            Grid.Row="0"
            Margin="8"
            ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="PropsColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <Grid
                x:Name="PreviewViewportHost"
                Grid.Column="0"
                Background="{ThemeResource WindowBackgroundBrush}"
                SizeChanged="PreviewViewportHost_SizeChanged">
                <ScrollViewer
                    x:Name="PreviewScrollViewer"
                    HorizontalScrollBarVisibility="Auto"
                    IsTabStop="True"
                    PointerCanceled="PreviewScrollViewer_PointerCanceled"
                    PointerCaptureLost="PreviewScrollViewer_PointerCaptureLost"
                    PointerMoved="PreviewScrollViewer_PointerMoved"
                    PointerPressed="PreviewScrollViewer_PointerPressed"
                    PointerReleased="PreviewScrollViewer_PointerReleased"
                    PointerWheelChanged="PreviewScrollViewer_PointerWheelChanged"
                    VerticalScrollBarVisibility="Auto">
                    <Grid
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                        <Image
                            x:Name="PreviewImage"
                            Height="{Binding PreviewImageHeight}"
                            HorizontalAlignment="Center"
                            Source="{Binding CurrentFrameBitmap}"
                            Stretch="Fill"
                            VerticalAlignment="Center"
                            Width="{Binding PreviewImageWidth}" />
                    </Grid>
                </ScrollViewer>
            </Grid>

            <Border
                x:Name="FramePropsPanel"
                Grid.Column="1"
                Padding="10"
                Background="{ThemeResource CardBrush}"
                BorderBrush="{ThemeResource CardBorderBrush}"
                BorderThickness="{StaticResource AppCardBorderThickness}"
                CornerRadius="{StaticResource AppCardCornerRadius}"
                Visibility="Collapsed">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        FontFamily="{StaticResource AppDisplayFont}"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Text="{Binding Texts.VapourSynthPreviewFramePropsPaneTitle}" />
                    <TextBox
                        Grid.Row="1"
                        AcceptsReturn="True"
                        Background="Transparent"
                        BorderThickness="0"
                        FontFamily="{StaticResource AppMonoFont}"
                        IsReadOnly="True"
                        ScrollViewer.HorizontalScrollBarVisibility="Auto"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        Text="{Binding FramePropsText}"
                        TextWrapping="NoWrap" />
                </Grid>
            </Border>
        </Grid>

        <!-- Main toolbar -->
        <Border
            Grid.Row="1"
            Margin="8,0,8,8"
            Padding="8,5"
            Background="{ThemeResource CardAltBrush}"
            BorderBrush="{ThemeResource CardBorderBrush}"
            BorderThickness="{StaticResource AppCardBorderThickness}"
            CornerRadius="{StaticResource AppCardCornerRadius}">
            <Grid RowSpacing="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Row 0: Output | Frame | Zoom | Timeline | Buttons -->
                <Grid ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock FontSize="12" VerticalAlignment="Center" Text="{Binding Texts.VapourSynthPreviewOutputHeader}" />
                    <ComboBox x:Name="OutputSelectorComboBox" Grid.Column="1" FontSize="12" MinHeight="26" Height="26" VerticalAlignment="Center" AutomationProperties.Name="{Binding Texts.VapourSynthPreviewOutputHeader}" DisplayMemberPath="Label" ItemsSource="{Binding Outputs}" SelectionChanged="OutputSelectorComboBox_SelectionChanged" />

                    <TextBlock Grid.Column="2" FontSize="12" VerticalAlignment="Center" Text="{Binding Texts.VapourSynthPreviewFrameHeader}" />
                    <NumberBox x:Name="FrameNumberBox" Grid.Column="3" FontSize="12" MinHeight="26" Height="26" VerticalAlignment="Center" AcceptsExpression="False" AutomationProperties.Name="{Binding Texts.VapourSynthPreviewFrameHeader}" LargeChange="10" LostFocus="FrameNumberBox_LostFocus" Minimum="0" SmallChange="1" SpinButtonPlacementMode="Hidden" Width="80" ValueChanged="FrameNumberBox_ValueChanged" />

                    <TextBlock Grid.Column="4" FontSize="12" VerticalAlignment="Center" Text="{Binding Texts.VapourSynthPreviewZoomHeader}" />
                    <ComboBox x:Name="ZoomModeComboBox" Grid.Column="5" FontSize="12" MinHeight="26" Height="26" VerticalAlignment="Center" MinWidth="0" AutomationProperties.Name="{Binding Texts.VapourSynthPreviewZoomHeader}" DisplayMemberPath="Label" ItemsSource="{Binding ZoomModes}" SelectedItem="{Binding SelectedZoomMode, Mode=TwoWay}" SelectionChanged="ZoomModeComboBox_SelectionChanged" />
                    <NumberBox x:Name="ZoomRatioBox" Grid.Column="6" FontSize="12" MinHeight="26" Height="26" VerticalAlignment="Center" AcceptsExpression="False" AutomationProperties.Name="{Binding Texts.VapourSynthPreviewZoomHeader}" Minimum="5" SmallChange="5" SpinButtonPlacementMode="Hidden" Width="72" ValueChanged="ZoomRatioBox_ValueChanged" Visibility="{Binding CustomZoomVisibility}" />

                    <TextBlock Grid.Column="7" FontSize="12" VerticalAlignment="Center" Text="{Binding Texts.VapourSynthPreviewTimelineModeHeader}" />
                    <ComboBox x:Name="TimelineModeComboBox" Grid.Column="8" FontSize="12" MinHeight="26" Height="26" VerticalAlignment="Center" AutomationProperties.Name="{Binding Texts.VapourSynthPreviewTimelineModeHeader}" DisplayMemberPath="Label" ItemsSource="{Binding TimelineModes}" SelectedItem="{Binding SelectedTimelineMode, Mode=TwoWay}" SelectionChanged="TimelineModeComboBox_SelectionChanged" />
                    <TextBlock Grid.Column="9" FontSize="12" VerticalAlignment="Center" Text="{Binding Texts.VapourSynthPreviewTimeStepHeader}" />
                    <NumberBox x:Name="TimeStepSecondsBox" Grid.Column="10" FontSize="12" MinHeight="26" Height="26" VerticalAlignment="Center" AcceptsExpression="False" AutomationProperties.Name="{Binding Texts.VapourSynthPreviewTimeStepHeader}" Minimum="0.001" SmallChange="0.1" SpinButtonPlacementMode="Hidden" Width="80" ValueChanged="TimeStepSecondsBox_ValueChanged" />
                    <Button x:Name="TimeStepBackButton" Grid.Column="11" MinWidth="28" MinHeight="26" Padding="4,2" VerticalAlignment="Center" AutomationProperties.Name="{Binding Texts.VapourSynthPreviewTimeStepBackButton}" Click="TimeStepBackButton_Click" ToolTipService.ToolTip="{Binding Texts.VapourSynthPreviewTimeStepBackButton}"><SymbolIcon Symbol="Back" /></Button>
                    <Button x:Name="TimeStepForwardButton" Grid.Column="12" MinWidth="28" MinHeight="26" Padding="4,2" VerticalAlignment="Center" AutomationProperties.Name="{Binding Texts.VapourSynthPreviewTimeStepForwardButton}" Click="TimeStepForwardButton_Click" ToolTipService.ToolTip="{Binding Texts.VapourSynthPreviewTimeStepForwardButton}"><SymbolIcon Symbol="Forward" /></Button>
                    <TextBlock Grid.Column="13" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource SubtleTextBrush}" Text="{Binding TimelinePositionText}" />

                    <StackPanel Grid.Column="15" Orientation="Horizontal" Spacing="1" VerticalAlignment="Center">
                        <Button x:Name="ReloadPreviewButton" MinWidth="30" MinHeight="26" Padding="4,2" Click="ReloadPreviewButton_Click" ToolTipService.ToolTip="{Binding Texts.VapourSynthReloadButton}"><SymbolIcon Symbol="Refresh" /></Button>
                        <Button x:Name="SaveAllOutputsButton" MinWidth="30" MinHeight="26" Padding="4,2" Click="SaveAllOutputsButton_Click" ToolTipService.ToolTip="保存所有节点截图"><FontIcon Glyph="&#xE105;" /></Button>
                        <Button x:Name="SaveSnapshotButton" MinWidth="30" MinHeight="26" Padding="4,2" Click="SaveSnapshotButton_Click" ToolTipService.ToolTip="{Binding Texts.VapourSynthPreviewSaveFrameButton}"><SymbolIcon Symbol="SaveLocal" /></Button>
                        <Button x:Name="CopyFrameButton" MinWidth="30" MinHeight="26" Padding="4,2" Click="CopyFrameButton_Click" ToolTipService.ToolTip="{Binding Texts.VapourSynthPreviewCopyFrameButton}"><SymbolIcon Symbol="Copy" /></Button>
                        <ToggleButton x:Name="CropToggleButton" MinWidth="30" MinHeight="26" Padding="4,2" VerticalAlignment="Center" Checked="CropToggleButton_Checked" Unchecked="CropToggleButton_Unchecked" ToolTipService.ToolTip="{Binding Texts.VapourSynthPreviewCropButton}"><SymbolIcon Symbol="Cut" /></ToggleButton>
                        <ToggleButton x:Name="FramePropsToggleButton" MinWidth="30" MinHeight="26" Padding="4,2" VerticalAlignment="Center" Checked="FramePropsToggleButton_Checked" Unchecked="FramePropsToggleButton_Unchecked" ToolTipService.ToolTip="{Binding Texts.VapourSynthPreviewFramePropsButton}"><SymbolIcon Symbol="List" /></ToggleButton>
                        <Button x:Name="AdvancedSettingsButton" MinWidth="30" MinHeight="26" Padding="4,2" VerticalAlignment="Center" Click="AdvancedSettingsButton_Click" ToolTipService.ToolTip="{Binding Texts.VapourSynthPreviewAdvancedSettingsButton}"><SymbolIcon Symbol="Setting" /></Button>
                    </StackPanel>
                </Grid>

                <!-- Row 1: Status info -->
                <Grid Grid.Row="1" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock FontSize="17" Foreground="{ThemeResource SubtleTextBrush}" Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" FontSize="17" Foreground="{ThemeResource SubtleTextBrush}" Text="{Binding FrameProgressText}" />
                    <TextBlock Grid.Column="2" FontSize="17" Foreground="{ThemeResource SubtleTextBrush}" Text="{Binding CurrentTimeText}" />
                    <TextBlock Grid.Column="3" FontSize="17" Foreground="{ThemeResource SubtleTextBrush}" Text="{Binding ResolutionText}" />
                    <TextBlock Grid.Column="4" FontSize="17" Foreground="{ThemeResource SubtleTextBrush}" Text="{Binding FormatText}" />
                    <TextBlock Grid.Column="5" FontSize="17" Foreground="{ThemeResource SubtleTextBrush}" Text="{Binding BitDepthText}" />
                    <TextBlock Grid.Column="6" FontSize="17" Foreground="{ThemeResource SubtleTextBrush}" Text="{Binding FpsText}" />
                    <TextBlock Grid.Column="7" FontSize="17" Foreground="{ThemeResource SubtleTextBrush}" Text="{Binding FrameTypeText}" />
                </Grid>

                <!-- Row 2: Playback + Chapters + Slider -->
                <Grid Grid.Row="2" ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button x:Name="FirstFrameButton" MinWidth="28" MinHeight="26" Padding="4" AutomationProperties.Name="{Binding Texts.VapourSynthPreviewFirstFrameButton}" Click="FirstFrameButton_Click" ToolTipService.ToolTip="{Binding Texts.VapourSynthPreviewFirstFrameButton}"><StackPanel Orientation="Horizontal" Spacing="0"><SymbolIcon Symbol="Back" /><SymbolIcon Symbol="Back" /></StackPanel></Button>
                    <Button x:Name="StepBackButton" Grid.Column="1" MinWidth="28" MinHeight="26" Padding="4" AutomationProperties.Name="{Binding Texts.VapourSynthPreviewPreviousFrameButton}" Click="StepBackButton_Click" ToolTipService.ToolTip="{Binding Texts.VapourSynthPreviewPreviousFrameButton}"><SymbolIcon Symbol="Back" /></Button>
                    <Button x:Name="PlayPauseButton" Grid.Column="2" MinWidth="28" MinHeight="26" Padding="4" AutomationProperties.Name="{Binding Texts.VapourSynthPreviewPlayPauseButton}" Click="PlayPauseButton_Click" ToolTipService.ToolTip="{Binding Texts.VapourSynthPreviewPlayPauseButton}"><SymbolIcon x:Name="PlayPauseIcon" Symbol="Play" /></Button>
                    <Button x:Name="StepForwardButton" Grid.Column="3" MinWidth="28" MinHeight="26" Padding="4" AutomationProperties.Name="{Binding Texts.VapourSynthPreviewNextFrameButton}" Click="StepForwardButton_Click" ToolTipService.ToolTip="{Binding Texts.VapourSynthPreviewNextFrameButton}"><SymbolIcon Symbol="Forward" /></Button>
                    <Button x:Name="LastFrameButton" Grid.Column="4" MinWidth="28" MinHeight="26" Padding="4" AutomationProperties.Name="{Binding Texts.VapourSynthPreviewLastFrameButton}" Click="LastFrameButton_Click" ToolTipService.ToolTip="{Binding Texts.VapourSynthPreviewLastFrameButton}"><StackPanel Orientation="Horizontal" Spacing="0"><SymbolIcon Symbol="Forward" /><SymbolIcon Symbol="Forward" /></StackPanel></Button>

                    <TextBlock Grid.Column="5" Margin="4,0,2,0" FontSize="12" VerticalAlignment="Center" Text="{Binding Texts.VapourSynthPreviewStepHeader}" />
                    <NumberBox x:Name="StepSizeBox" Grid.Column="6" FontSize="12" MinHeight="26" Height="26" VerticalAlignment="Center" AcceptsExpression="False" AutomationProperties.Name="{Binding Texts.VapourSynthPreviewStepHeader}" Minimum="1" SmallChange="1" SpinButtonPlacementMode="Hidden" Width="80" Value="1" ValueChanged="StepSizeBox_ValueChanged" />

                    <!-- Chapter buttons group -->
                    <StackPanel Grid.Column="7" Orientation="Horizontal" Spacing="1" VerticalAlignment="Center">
                        <Button x:Name="ImportChapterButton" MinWidth="30" MinHeight="26" Padding="4,2" Click="ImportChapterButton_Click" ToolTipService.ToolTip="导入章节"><FontIcon Glyph="&#xE8E5;" /></Button>
                        <Button x:Name="EditChapterButton" MinWidth="30" MinHeight="26" Padding="4,2" IsEnabled="False" Click="EditChapterButton_Click" ToolTipService.ToolTip="编辑章节"><FontIcon Glyph="&#xE70F;" /></Button>
                        <Button x:Name="NextChapterButton" MinWidth="30" MinHeight="26" Padding="4,2" IsEnabled="False" Click="NextChapterButton_Click" ToolTipService.ToolTip="下一章节"><SymbolIcon Symbol="Forward" /></Button>
                        <Button x:Name="ExportChapterButton" MinWidth="30" MinHeight="26" Padding="4,2" IsEnabled="False" Click="ExportChapterButton_Click" ToolTipService.ToolTip="导出章节"><FontIcon Glyph="&#xED25;" /></Button>
                    </StackPanel>

                    <!-- Slider with chapter markers overlay -->
                    <Grid Grid.Column="8" PointerPressed="SliderGrid_PointerPressed">
                        <Slider x:Name="FrameSlider" AutomationProperties.Name="{Binding Texts.VapourSynthPreviewFrameHeader}" LargeChange="10" Minimum="0" SmallChange="1" ValueChanged="FrameSlider_ValueChanged" />
                        <Canvas x:Name="ChapterMarkCanvas" IsHitTestVisible="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <!-- Crop panel -->
        <Border
            Grid.Row="2"
            Margin="8,0,8,8"
            Padding="8,5"
            Background="{ThemeResource CardAltBrush}"
            BorderBrush="{ThemeResource CardBorderBrush}"
            BorderThickness="{StaticResource AppCardBorderThickness}"
            CornerRadius="{StaticResource AppCardCornerRadius}"
            Visibility="{Binding CropPanelVisibility}">
            <Grid ColumnSpacing="3" RowSpacing="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="60" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="60" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="60" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="60" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="60" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="60" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="76" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock FontSize="12" VerticalAlignment="Center" Text="{Binding Texts.VapourSynthPreviewCropModeHeader}" />
                <ComboBox x:Name="CropModeComboBox" Grid.Column="1" FontSize="12" MinHeight="26" AutomationProperties.Name="{Binding Texts.VapourSynthPreviewCropModeHeader}" DisplayMemberPath="Label" ItemsSource="{Binding CropModes}" SelectedItem="{Binding SelectedCropMode, Mode=TwoWay}" SelectionChanged="CropModeComboBox_SelectionChanged" />
                <TextBlock Grid.Column="2" FontSize="12" VerticalAlignment="Center" Text="{Binding Texts.VapourSynthPreviewCropLeftHeader}" />
                <NumberBox x:Name="CropLeftBox" Grid.Column="3" FontSize="12" MinHeight="26" VerticalAlignment="Center" AcceptsExpression="False" AutomationProperties.Name="{Binding Texts.VapourSynthPreviewCropLeftHeader}" Minimum="0" SpinButtonPlacementMode="Hidden" ValueChanged="CropLeftBox_ValueChanged" />
                <TextBlock Grid.Column="4" FontSize="12" VerticalAlignment="Center" Text="{Binding Texts.VapourSynthPreviewCropTopHeader}" />
                <NumberBox x:Name="CropTopBox" Grid.Column="5" FontSize="12" MinHeight="26" VerticalAlignment="Center" AcceptsExpression="False" AutomationProperties.Name="{Binding Texts.VapourSynthPreviewCropTopHeader}" Minimum="0" SpinButtonPlacementMode="Hidden" ValueChanged="CropTopBox_ValueChanged" />
                <TextBlock Grid.Column="6" FontSize="12" VerticalAlignment="Center" Text="{Binding Texts.VapourSynthPreviewCropWidthHeader}" />
                <NumberBox x:Name="CropWidthBox" Grid.Column="7" FontSize="12" MinHeight="26" VerticalAlignment="Center" AcceptsExpression="False" AutomationProperties.Name="{Binding Texts.VapourSynthPreviewCropWidthHeader}" Minimum="1" SpinButtonPlacementMode="Hidden" ValueChanged="CropWidthBox_ValueChanged" />
                <TextBlock Grid.Column="8" FontSize="12" VerticalAlignment="Center" Text="{Binding Texts.VapourSynthPreviewCropHeightHeader}" />
                <NumberBox x:Name="CropHeightBox" Grid.Column="9" FontSize="12" MinHeight="26" VerticalAlignment="Center" AcceptsExpression="False" AutomationProperties.Name="{Binding Texts.VapourSynthPreviewCropHeightHeader}" Minimum="1" SpinButtonPlacementMode="Hidden" ValueChanged="CropHeightBox_ValueChanged" />
                <TextBlock Grid.Column="10" FontSize="12" VerticalAlignment="Center" Text="{Binding Texts.VapourSynthPreviewCropRightHeader}" />
                <NumberBox x:Name="CropRightBox" Grid.Column="11" FontSize="12" MinHeight="26" VerticalAlignment="Center" AcceptsExpression="False" AutomationProperties.Name="{Binding Texts.VapourSynthPreviewCropRightHeader}" Minimum="0" SpinButtonPlacementMode="Hidden" ValueChanged="CropRightBox_ValueChanged" />
                <TextBlock Grid.Column="12" FontSize="12" VerticalAlignment="Center" Text="{Binding Texts.VapourSynthPreviewCropBottomHeader}" />
                <NumberBox x:Name="CropBottomBox" Grid.Column="13" FontSize="12" MinHeight="26" VerticalAlignment="Center" AcceptsExpression="False" AutomationProperties.Name="{Binding Texts.VapourSynthPreviewCropBottomHeader}" Minimum="0" SpinButtonPlacementMode="Hidden" ValueChanged="CropBottomBox_ValueChanged" />
                <TextBlock Grid.Column="14" FontSize="12" VerticalAlignment="Center" Text="{Binding Texts.VapourSynthPreviewCropZoomHeader}" />
                <NumberBox x:Name="CropZoomBox" Grid.Column="15" FontSize="12" MinHeight="26" VerticalAlignment="Center" AcceptsExpression="False" AutomationProperties.Name="{Binding Texts.VapourSynthPreviewCropZoomHeader}" Minimum="10" SmallChange="10" SpinButtonPlacementMode="Hidden" ValueChanged="CropZoomBox_ValueChanged" />
                <Button x:Name="CopyCropCommandButton" Grid.Column="16" FontSize="12" Padding="6,2" MinHeight="26" VerticalAlignment="Center" AutomationProperties.Name="{Binding Texts.VapourSynthPreviewCopyCropCommandButton}" Click="CopyCropCommandButton_Click" ToolTipService.ToolTip="{Binding Texts.VapourSynthPreviewCopyCropCommandButton}"><StackPanel Orientation="Horizontal" Spacing="4"><SymbolIcon Symbol="Copy" /><TextBlock Text="{Binding Texts.VapourSynthPreviewCopyCropCommandButton}" /></StackPanel></Button>
                <TextBlock Grid.Row="1" Grid.ColumnSpan="19" FontSize="11" Foreground="{ThemeResource SubtleTextBrush}" Text="{Binding ResolutionText}" />
            </Grid>
        </Border>
    </Grid>
</Window>