<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="FlowEncode.Controls.Shared.AnimatedExpander"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border
            x:Name="HeaderBorder"
            Background="Transparent"
            BorderBrush="{ThemeResource CardBorderBrush}"
            BorderThickness="{StaticResource AppCardBorderThickness}"
            CornerRadius="{StaticResource AppControlCornerRadius}"
            Tapped="HeaderBorder_Tapped">
            <Grid
                x:Name="HeaderHitTarget"
                Padding="{Binding HeaderPadding, ElementName=Root}"
                ColumnSpacing="{StaticResource AppSpacingM}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ContentPresenter
                    Content="{Binding HeaderContent, ElementName=Root}"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center" />

                <Button
                    x:Name="ChevronButton"
                    Grid.Column="1"
                    Click="ChevronButton_Click"
                    Style="{StaticResource IconButtonStyle}"
                    ToolTipService.ToolTip="Toggle section"
                    VerticalAlignment="Center">
                    <FontIcon
                        x:Name="ChevronIcon"
                        FontSize="{StaticResource AppBodyFontSize}"
                        Glyph="&#xE70D;" />
                </Button>
            </Grid>
        </Border>

        <Border
            x:Name="ContentBorder"
            Grid.Row="1"
            Margin="0,-1,0,0"
            Background="Transparent"
            BorderBrush="{ThemeResource CardBorderBrush}"
            BorderThickness="{StaticResource AppCardBorderThickness}"
            CornerRadius="0,0,6,6"
            Visibility="Collapsed">
            <Grid
                x:Name="ContentClipHost"
                Height="0"
                SizeChanged="ContentClipHost_SizeChanged"
                VerticalAlignment="Top">
                <Border
                    x:Name="ContentInnerRoot"
                    Margin="{Binding ContentMargin, ElementName=Root}"
                    VerticalAlignment="Top">
                    <ContentPresenter Content="{Binding BodyContent, ElementName=Root}" />
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
