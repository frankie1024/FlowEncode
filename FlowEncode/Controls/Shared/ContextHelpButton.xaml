<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="FlowEncode.Controls.Shared.ContextHelpButton" x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Button Width="28" Height="28" MinWidth="0" MinHeight="0" Padding="0" Background="Transparent" BorderThickness="0" AutomationProperties.Name="{Binding Title, ElementName=Root}">
        <SymbolIcon Symbol="Help" />
        <ToolTipService.ToolTip>
            <ToolTip MaxWidth="480" Opened="HelpToolTip_Opened"><TextBlock x:Name="HelpToolTipText" TextWrapping="Wrap" /></ToolTip>
        </ToolTipService.ToolTip>
        <Button.Flyout>
            <Flyout Opening="HelpFlyout_Opening">
                <StackPanel Width="440" Spacing="10">
                    <TextBlock x:Name="HelpTitleText" FontWeight="SemiBold" />
                    <ScrollViewer MaxHeight="380" VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="HelpBodyText" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    </ScrollViewer>
                </StackPanel>
            </Flyout>
        </Button.Flyout>
    </Button>
</UserControl>
