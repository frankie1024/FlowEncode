<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="FlowEncode.Controls.Shared.WorkflowPageShell"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shared="using:FlowEncode.Controls.Shared">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="ShellStack" Padding="{Binding PagePadding, ElementName=Root}" Spacing="{StaticResource AppSpacingL}">
            <shared:PageHeader
                x:Name="PageHeaderPresenter"
                Title="{Binding Title, ElementName=Root}"
                Description="{Binding Description, ElementName=Root}"
                StatusText="{Binding StatusText, ElementName=Root}"
                ActionsContent="{Binding HeaderActionsContent, ElementName=Root}"
                IsStacked="{Binding IsHeaderStacked, ElementName=Root}" />

            <Grid x:Name="WorkspaceGrid" ColumnSpacing="{StaticResource AppSpacingL}">
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="WorkspacePrimaryRow" Height="Auto" />
                    <RowDefinition x:Name="WorkspaceSecondaryRow" Height="0" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="PrimaryColumn" Width="0.55*" />
                    <ColumnDefinition x:Name="SecondaryColumn" Width="0.45*" />
                </Grid.ColumnDefinitions>

                <ContentPresenter x:Name="PrimaryPresenter" Content="{Binding PrimaryContent, ElementName=Root}" />
                <ContentPresenter x:Name="SecondaryPresenter" Grid.Column="1" Content="{Binding SecondaryContent, ElementName=Root}" />
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
