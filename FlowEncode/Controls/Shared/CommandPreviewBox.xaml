<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="FlowEncode.Controls.Shared.CommandPreviewBox"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid RowSpacing="{StaticResource AppSpacingS}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="{StaticResource AppSpacingM}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                FontFamily="{StaticResource AppDisplayFont}"
                FontSize="{StaticResource AppBodyLargeFontSize}"
                FontWeight="SemiBold"
                Text="{x:Bind Header, Mode=OneWay}"
                TextTrimming="CharacterEllipsis" />

            <Button
                x:Name="CopyCommandButton"
                Grid.Column="1"
                Click="CopyCommandButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource AppCommandIconTextSpacing}">
                    <SymbolIcon Symbol="Copy" />
                    <TextBlock x:Name="CopyCommandButtonLabelTextBlock" />
                </StackPanel>
            </Button>
        </Grid>

        <TextBox
            Grid.Row="1"
            Height="{x:Bind PreviewHeight, Mode=OneWay}"
            MinHeight="{x:Bind PreviewMinHeight, Mode=OneWay}"
            FontFamily="{StaticResource AppMonoFont}"
            IsReadOnly="True"
            PlaceholderText="{x:Bind PlaceholderText, Mode=OneWay}"
            ScrollViewer.VerticalScrollBarVisibility="Auto"
            Text="{x:Bind Text, Mode=OneWay}"
            TextWrapping="Wrap" />

        <TextBlock
            x:Name="StatusTextBlock"
            Grid.Row="2"
            AutomationProperties.LiveSetting="Polite"
            FontSize="{StaticResource AppSmallFontSize}"
            Foreground="{ThemeResource SubtleTextBrush}"
            TextWrapping="WrapWholeWords"
            Visibility="Collapsed" />
    </Grid>
</UserControl>
