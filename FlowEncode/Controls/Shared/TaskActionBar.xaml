<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="FlowEncode.Controls.Shared.TaskActionBar"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="ActionGrid" ColumnSpacing="{StaticResource AppSpacingM}" RowSpacing="{StaticResource AppSpacingM}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="PrimaryColumn" Width="*" />
            <ColumnDefinition x:Name="SecondaryColumn" Width="*" />
            <ColumnDefinition x:Name="TertiaryColumn" Width="*" />
        </Grid.ColumnDefinitions>
        <ContentPresenter x:Name="PrimaryPresenter" Content="{Binding PrimaryContent, ElementName=Root}" />
        <ContentPresenter x:Name="SecondaryPresenter" Grid.Column="1" Content="{Binding SecondaryContent, ElementName=Root}" />
        <ContentPresenter x:Name="TertiaryPresenter" Grid.Column="2" Content="{Binding TertiaryContent, ElementName=Root}" />
    </Grid>
</UserControl>
