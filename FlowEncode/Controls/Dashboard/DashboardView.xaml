<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="FlowEncode.Controls.Dashboard.DashboardView"
    x:Name="RootView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shared="using:FlowEncode.Controls.Shared"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="DashboardModuleIconBadgeStyle" TargetType="Border">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="{StaticResource AppCardBorderThickness}" />
        </Style>

        <Style x:Key="DashboardActivityIndicatorStyle" TargetType="Border">
            <Setter Property="Width" Value="10" />
            <Setter Property="Height" Value="10" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Background" Value="{ThemeResource SystemFillColorSolidNeutralBrush}" />
            <Setter Property="CornerRadius" Value="999" />
        </Style>

        <Style x:Key="DashboardCardProgressBarStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="4" />
            <Setter Property="Maximum" Value="1" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{ThemeResource QueueProgressFillBrush}" />
            <Setter Property="Background" Value="{ThemeResource QueueProgressSoftBrush}" />
            <Setter Property="shared:ProgressEffects.IsEnabled" Value="True" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>

        <Style x:Key="DashboardCardButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Background" Value="{ThemeResource CardBrush}" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="{StaticResource AppCardBorderThickness}" />
            <Setter Property="CornerRadius" Value="{StaticResource AppCardCornerRadius}" />
            <Setter Property="Padding" Value="{StaticResource AppCardPadding}" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="shared:UiElevation.Level" Value="E1" />
            <Setter Property="shared:UiElevation.HoverLevel" Value="E2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="CardRoot"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource AppCardCornerRadius}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal">
                                        <Storyboard>
                                            <PointerUpThemeAnimation Storyboard.TargetName="CardRoot" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="InteractionOverlay.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                            <Setter Target="CardRoot.BorderBrush" Value="{ThemeResource ThemeBorderElevatedBrush}" />
                                        </VisualState.Setters>
                                        <Storyboard>
                                            <PointerUpThemeAnimation Storyboard.TargetName="CardRoot" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="InteractionOverlay.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                            <Setter Target="CardRoot.BorderBrush" Value="{ThemeResource ThemeBorderElevatedBrush}" />
                                        </VisualState.Setters>
                                        <Storyboard>
                                            <PointerDownThemeAnimation Storyboard.TargetName="CardRoot" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="CardRoot.Background" Value="{ThemeResource ButtonBackgroundDisabled}" />
                                            <Setter Target="CardRoot.BorderBrush" Value="{ThemeResource ButtonBorderBrushDisabled}" />
                                            <Setter Target="CardContent.Foreground" Value="{ThemeResource ButtonForegroundDisabled}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Grid>
                                <Border x:Name="InteractionOverlay" IsHitTestVisible="False" CornerRadius="{StaticResource AppCardCornerRadius}" />
                                <ContentPresenter
                                    x:Name="CardContent"
                                    Padding="{TemplateBinding Padding}"
                                    HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    ContentTransitions="{TemplateBinding ContentTransitions}"
                                    Foreground="{TemplateBinding Foreground}" />
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ContentTransitions">
                <Setter.Value>
                    <TransitionCollection />
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer x:Name="DashboardScroller" VerticalScrollBarVisibility="Auto">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="DemuxStatusStates">
                <VisualState x:Name="DemuxIdle" />
                <VisualState x:Name="DemuxRunning">
                    <VisualState.Setters>
                        <Setter Target="DemuxStatusDot.Background" Value="{ThemeResource QueueProgressFillBrush}" />
                        <Setter Target="DemuxStatusText.Foreground" Value="{ThemeResource QueueProgressFillBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="DemuxCompleted">
                    <VisualState.Setters>
                        <Setter Target="DemuxStatusDot.Background" Value="{ThemeResource SystemFillColorSuccessBrush}" />
                        <Setter Target="DemuxStatusText.Foreground" Value="{ThemeResource SystemFillColorSuccessBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="DemuxFailed">
                    <VisualState.Setters>
                        <Setter Target="DemuxStatusDot.Background" Value="{ThemeResource SystemFillColorCriticalBrush}" />
                        <Setter Target="DemuxStatusText.Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="DemuxCancelled">
                    <VisualState.Setters>
                        <Setter Target="DemuxStatusDot.Background" Value="{ThemeResource SystemFillColorSolidNeutralBrush}" />
                        <Setter Target="DemuxStatusText.Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
            <VisualStateGroup x:Name="OverviewStatusStates">
                <VisualState x:Name="OverviewIdle" />
                <VisualState x:Name="OverviewRunning">
                    <VisualState.Setters>
                        <Setter Target="OverviewStatusDot.Background" Value="{ThemeResource QueueProgressFillBrush}" />
                        <Setter Target="OverviewStatusText.Foreground" Value="{ThemeResource QueueProgressFillBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="OverviewCompleted">
                    <VisualState.Setters>
                        <Setter Target="OverviewStatusDot.Background" Value="{ThemeResource SystemFillColorSuccessBrush}" />
                        <Setter Target="OverviewStatusText.Foreground" Value="{ThemeResource SystemFillColorSuccessBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="OverviewFailed">
                    <VisualState.Setters>
                        <Setter Target="OverviewStatusDot.Background" Value="{ThemeResource SystemFillColorCriticalBrush}" />
                        <Setter Target="OverviewStatusText.Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="OverviewCancelled">
                    <VisualState.Setters>
                        <Setter Target="OverviewStatusDot.Background" Value="{ThemeResource SystemFillColorSolidNeutralBrush}" />
                        <Setter Target="OverviewStatusText.Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
            <VisualStateGroup x:Name="AudioStatusStates">
                <VisualState x:Name="AudioIdle" />
                <VisualState x:Name="AudioRunning">
                    <VisualState.Setters>
                        <Setter Target="AudioStatusDot.Background" Value="{ThemeResource QueueProgressFillBrush}" />
                        <Setter Target="AudioStatusText.Foreground" Value="{ThemeResource QueueProgressFillBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="AudioCompleted">
                    <VisualState.Setters>
                        <Setter Target="AudioStatusDot.Background" Value="{ThemeResource SystemFillColorSuccessBrush}" />
                        <Setter Target="AudioStatusText.Foreground" Value="{ThemeResource SystemFillColorSuccessBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="AudioFailed">
                    <VisualState.Setters>
                        <Setter Target="AudioStatusDot.Background" Value="{ThemeResource SystemFillColorCriticalBrush}" />
                        <Setter Target="AudioStatusText.Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="AudioCancelled">
                    <VisualState.Setters>
                        <Setter Target="AudioStatusDot.Background" Value="{ThemeResource SystemFillColorSolidNeutralBrush}" />
                        <Setter Target="AudioStatusText.Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
            <VisualStateGroup x:Name="AutoStatusStates">
                <VisualState x:Name="AutoIdle" />
                <VisualState x:Name="AutoRunning">
                    <VisualState.Setters>
                        <Setter Target="AutoStatusDot.Background" Value="{ThemeResource QueueProgressFillBrush}" />
                        <Setter Target="AutoStatusText.Foreground" Value="{ThemeResource QueueProgressFillBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="AutoCompleted">
                    <VisualState.Setters>
                        <Setter Target="AutoStatusDot.Background" Value="{ThemeResource SystemFillColorSuccessBrush}" />
                        <Setter Target="AutoStatusText.Foreground" Value="{ThemeResource SystemFillColorSuccessBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="AutoFailed">
                    <VisualState.Setters>
                        <Setter Target="AutoStatusDot.Background" Value="{ThemeResource SystemFillColorCriticalBrush}" />
                        <Setter Target="AutoStatusText.Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="AutoCancelled">
                    <VisualState.Setters>
                        <Setter Target="AutoStatusDot.Background" Value="{ThemeResource SystemFillColorSolidNeutralBrush}" />
                        <Setter Target="AutoStatusText.Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid x:Name="DashboardContentStack" Padding="{StaticResource AppPagePadding}" RowSpacing="{StaticResource AppSpacingL}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border x:Name="DashboardHeroCard" MinHeight="148" Padding="{StaticResource AppCardPadding}" Background="{ThemeResource HeroBrush}" BorderBrush="{ThemeResource ThemeBorderHeroBrush}" BorderThickness="{StaticResource AppCardBorderThickness}" CornerRadius="{StaticResource AppLargeCornerRadius}" Shadow="{StaticResource HeroShadow}">
                <Grid x:Name="DashboardHeroGrid" ColumnSpacing="{StaticResource AppSpacingL}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel x:Name="DashboardHeaderPanel" HorizontalAlignment="Left" Spacing="{StaticResource AppSpacingXS}" VerticalAlignment="Center">
                        <TextBlock x:Name="DashboardHeaderTitle" HorizontalAlignment="Left" FontFamily="{StaticResource AppDisplayFont}" FontSize="{StaticResource AppDisplayFontSize}" FontWeight="SemiBold" Text="FlowEncode" TextWrapping="WrapWholeWords" />
                    </StackPanel>

                    <Border x:Name="DashboardHeroIconFrame" Grid.Column="1" Width="136" Height="136" Padding="0" Background="Transparent" BorderThickness="0" CornerRadius="0">
                        <Image Stretch="Uniform" AutomationProperties.AccessibilityView="Raw">
                            <Image.Source>
                                <BitmapImage UriSource="ms-appx:///Assets/FlowEncodeHammer.png" />
                            </Image.Source>
                        </Image>
                    </Border>
                </Grid>
            </Border>

            <Grid x:Name="DashboardCardGrid" Grid.Row="1" ColumnSpacing="{StaticResource AppSpacingL}" RowSpacing="{StaticResource AppSpacingL}" VerticalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="DashboardRow0" Height="Auto" />
                    <RowDefinition x:Name="DashboardRow1" Height="Auto" />
                    <RowDefinition x:Name="DashboardRow2" Height="Auto" />
                    <RowDefinition x:Name="DashboardRow3" Height="Auto" />
                    <RowDefinition x:Name="DashboardRow4" Height="Auto" />
                    <RowDefinition x:Name="DashboardRow5" Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="DashboardPrimaryColumn" Width="*" />
                    <ColumnDefinition x:Name="DashboardSecondaryColumn" Width="*" />
                    <ColumnDefinition x:Name="DashboardTertiaryColumn" Width="*" />
                </Grid.ColumnDefinitions>

                <Button x:Name="DashboardDemuxButton" Grid.Row="0" Grid.Column="0" MinHeight="188" HorizontalAlignment="Stretch" AutomationProperties.Name="{Binding Texts.NavBluRayDemux}" Style="{StaticResource DashboardCardButtonStyle}" Click="DashboardCardButton_Click" Tag="bluray-demux" ToolTipService.ToolTip="{Binding Texts.NavBluRayDemux}">
                    <Grid RowSpacing="{StaticResource AppSpacingL}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid ColumnSpacing="{StaticResource AppSpacingS}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Background="{ThemeResource ThemeModuleDemuxSoftBrush}" Style="{StaticResource DashboardModuleIconBadgeStyle}">
                                <Viewbox Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <SymbolIcon Symbol="Library" Foreground="{ThemeResource ThemeModuleDemuxBrush}" />
                                </Viewbox>
                            </Border>

                            <Border x:Name="DemuxStatusDot" Grid.Column="1" Style="{StaticResource DashboardActivityIndicatorStyle}" Visibility="{Binding DashboardBluRayDemuxStatusVisibility}" />
                        </Grid>

                        <StackPanel Grid.Row="1" Spacing="{StaticResource AppSpacingS}">
                            <TextBlock FontFamily="{StaticResource AppDisplayFont}" FontSize="{StaticResource AppHeadlineFontSize}" FontWeight="SemiBold" Text="{Binding Texts.NavBluRayDemux}" TextWrapping="WrapWholeWords" />
                            <TextBlock Foreground="{ThemeResource SubtleTextBrush}" MaxLines="3" Text="{Binding Texts.DashboardDemuxCardDescription}" TextTrimming="CharacterEllipsis" TextWrapping="WrapWholeWords" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Spacing="{StaticResource AppSpacingXS}">
                            <TextBlock x:Name="DemuxStatusText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="{StaticResource AppCaptionFontSize}" FontWeight="SemiBold" Text="{Binding DashboardBluRayDemuxStatusText}" MaxLines="1" TextTrimming="CharacterEllipsis" Visibility="{Binding DashboardBluRayDemuxStatusVisibility}" />
                            <Grid ColumnSpacing="{StaticResource AppSpacingM}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ProgressBar
                                    Style="{StaticResource DashboardCardProgressBarStyle}"
                                    IsIndeterminate="{Binding DashboardBluRayDemuxProgressIsIndeterminate}"
                                    Value="{Binding DashboardBluRayDemuxProgressValue}"
                                    Visibility="{Binding DashboardBluRayDemuxProgressVisibility}" />
                                <SymbolIcon Grid.Column="1" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Symbol="Forward" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Button>

                <Button x:Name="DashboardVapourSynthButton" Grid.Row="0" Grid.Column="1" MinHeight="188" HorizontalAlignment="Stretch" AutomationProperties.Name="{Binding Texts.NavVapourSynthWorkspace}" Style="{StaticResource DashboardCardButtonStyle}" Click="DashboardCardButton_Click" Tag="vapoursynth-workspace" ToolTipService.ToolTip="{Binding Texts.NavVapourSynthWorkspace}">
                    <Grid RowSpacing="{StaticResource AppSpacingL}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Background="{ThemeResource ThemeModuleScriptSoftBrush}" Style="{StaticResource DashboardModuleIconBadgeStyle}">
                            <Viewbox Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <SymbolIcon Symbol="Edit" Foreground="{ThemeResource ThemeModuleScriptBrush}" />
                            </Viewbox>
                        </Border>

                        <StackPanel Grid.Row="1" Spacing="{StaticResource AppSpacingS}">
                            <TextBlock FontFamily="{StaticResource AppDisplayFont}" FontSize="{StaticResource AppHeadlineFontSize}" FontWeight="SemiBold" Text="{Binding Texts.NavVapourSynthWorkspace}" TextWrapping="WrapWholeWords" />
                            <TextBlock Foreground="{ThemeResource SubtleTextBrush}" MaxLines="3" Text="{Binding Texts.DashboardVapourSynthCardDescription}" TextTrimming="CharacterEllipsis" TextWrapping="WrapWholeWords" />
                        </StackPanel>

                        <Grid Grid.Row="2" ColumnSpacing="{StaticResource AppSpacingM}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <SymbolIcon Grid.Column="1" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Symbol="Forward" />
                        </Grid>
                    </Grid>
                </Button>

                <Button x:Name="DashboardVideoEncodeButton" Grid.Row="0" Grid.Column="2" MinHeight="188" HorizontalAlignment="Stretch" AutomationProperties.Name="{Binding Texts.NavOverview}" Style="{StaticResource DashboardCardButtonStyle}" Click="DashboardCardButton_Click" Tag="overview" ToolTipService.ToolTip="{Binding Texts.NavOverview}">
                    <Grid RowSpacing="{StaticResource AppSpacingL}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid ColumnSpacing="{StaticResource AppSpacingS}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Background="{ThemeResource ThemeModuleVideoSoftBrush}" Style="{StaticResource DashboardModuleIconBadgeStyle}">
                                <Viewbox Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <SymbolIcon Symbol="Video" Foreground="{ThemeResource ThemeModuleVideoBrush}" />
                                </Viewbox>
                            </Border>

                            <Border x:Name="OverviewStatusDot" Grid.Column="1" Style="{StaticResource DashboardActivityIndicatorStyle}" Visibility="{Binding DashboardOverviewStatusVisibility}" />
                        </Grid>

                        <StackPanel Grid.Row="1" Spacing="{StaticResource AppSpacingS}">
                            <TextBlock FontFamily="{StaticResource AppDisplayFont}" FontSize="{StaticResource AppHeadlineFontSize}" FontWeight="SemiBold" Text="{Binding Texts.NavOverview}" TextWrapping="WrapWholeWords" />
                            <TextBlock Foreground="{ThemeResource SubtleTextBrush}" MaxLines="3" Text="{Binding Texts.DashboardVideoEncodeCardDescription}" TextTrimming="CharacterEllipsis" TextWrapping="WrapWholeWords" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Spacing="{StaticResource AppSpacingXS}">
                            <TextBlock x:Name="OverviewStatusText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="{StaticResource AppCaptionFontSize}" FontWeight="SemiBold" Text="{Binding DashboardOverviewStatusText}" MaxLines="1" TextTrimming="CharacterEllipsis" Visibility="{Binding DashboardOverviewStatusVisibility}" />
                            <Grid ColumnSpacing="{StaticResource AppSpacingM}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ProgressBar
                                    Style="{StaticResource DashboardCardProgressBarStyle}"
                                    IsIndeterminate="{Binding DashboardOverviewProgressIsIndeterminate}"
                                    Value="{Binding DashboardOverviewProgressValue}"
                                    Visibility="{Binding DashboardOverviewProgressVisibility}" />
                                <SymbolIcon Grid.Column="1" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Symbol="Forward" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Button>

                <Button x:Name="DashboardAudioButton" Grid.Row="1" Grid.Column="0" MinHeight="188" HorizontalAlignment="Stretch" AutomationProperties.Name="{Binding Texts.NavAudioProcessing}" Style="{StaticResource DashboardCardButtonStyle}" Click="DashboardCardButton_Click" Tag="audio-process" ToolTipService.ToolTip="{Binding Texts.NavAudioProcessing}">
                    <Grid RowSpacing="{StaticResource AppSpacingL}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid ColumnSpacing="{StaticResource AppSpacingS}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Background="{ThemeResource ThemeModuleAudioSoftBrush}" Style="{StaticResource DashboardModuleIconBadgeStyle}">
                                <Viewbox Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <SymbolIcon Symbol="Audio" Foreground="{ThemeResource ThemeModuleAudioBrush}" />
                                </Viewbox>
                            </Border>

                            <Border x:Name="AudioStatusDot" Grid.Column="1" Style="{StaticResource DashboardActivityIndicatorStyle}" Visibility="{Binding DashboardAudioProcessingStatusVisibility}" />
                        </Grid>

                        <StackPanel Grid.Row="1" Spacing="{StaticResource AppSpacingS}">
                            <TextBlock FontFamily="{StaticResource AppDisplayFont}" FontSize="{StaticResource AppHeadlineFontSize}" FontWeight="SemiBold" Text="{Binding Texts.NavAudioProcessing}" TextWrapping="WrapWholeWords" />
                            <TextBlock Foreground="{ThemeResource SubtleTextBrush}" MaxLines="3" Text="{Binding Texts.DashboardAudioTranscodeCardDescription}" TextTrimming="CharacterEllipsis" TextWrapping="WrapWholeWords" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Spacing="{StaticResource AppSpacingXS}">
                            <TextBlock x:Name="AudioStatusText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="{StaticResource AppCaptionFontSize}" FontWeight="SemiBold" Text="{Binding DashboardAudioProcessingStatusText}" MaxLines="1" TextTrimming="CharacterEllipsis" Visibility="{Binding DashboardAudioProcessingStatusVisibility}" />
                            <Grid ColumnSpacing="{StaticResource AppSpacingM}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ProgressBar
                                    Style="{StaticResource DashboardCardProgressBarStyle}"
                                    IsIndeterminate="{Binding DashboardAudioProcessingProgressIsIndeterminate}"
                                    Value="{Binding DashboardAudioProcessingProgressValue}"
                                    Visibility="{Binding DashboardAudioProcessingProgressVisibility}" />
                                <SymbolIcon Grid.Column="1" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Symbol="Forward" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Button>

                <Button x:Name="DashboardAutoCompressionButton" Grid.Row="1" Grid.Column="1" MinHeight="188" HorizontalAlignment="Stretch" AutomationProperties.Name="{Binding Texts.NavAutoCompression}" Style="{StaticResource DashboardCardButtonStyle}" Click="DashboardCardButton_Click" Tag="auto-compress" ToolTipService.ToolTip="{Binding Texts.NavAutoCompression}">
                    <Grid RowSpacing="{StaticResource AppSpacingL}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid ColumnSpacing="{StaticResource AppSpacingS}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Background="{ThemeResource ThemeModuleAutoSoftBrush}" Style="{StaticResource DashboardModuleIconBadgeStyle}">
                                <Viewbox Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <SymbolIcon Symbol="Play" Foreground="{ThemeResource ThemeModuleAutoBrush}" />
                                </Viewbox>
                            </Border>

                            <Border x:Name="AutoStatusDot" Grid.Column="1" Style="{StaticResource DashboardActivityIndicatorStyle}" Visibility="{Binding DashboardAutoCompressionStatusVisibility}" />
                        </Grid>

                        <StackPanel Grid.Row="1" Spacing="{StaticResource AppSpacingS}">
                            <TextBlock FontFamily="{StaticResource AppDisplayFont}" FontSize="{StaticResource AppHeadlineFontSize}" FontWeight="SemiBold" Text="{Binding Texts.NavAutoCompression}" TextWrapping="WrapWholeWords" />
                            <TextBlock Foreground="{ThemeResource SubtleTextBrush}" MaxLines="3" Text="{Binding Texts.DashboardAutoCompressionCardDescription}" TextTrimming="CharacterEllipsis" TextWrapping="WrapWholeWords" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Spacing="{StaticResource AppSpacingXS}">
                            <TextBlock x:Name="AutoStatusText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="{StaticResource AppCaptionFontSize}" FontWeight="SemiBold" Text="{Binding DashboardAutoCompressionStatusText}" MaxLines="1" TextTrimming="CharacterEllipsis" Visibility="{Binding DashboardAutoCompressionStatusVisibility}" />
                            <Grid ColumnSpacing="{StaticResource AppSpacingM}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ProgressBar
                                    Style="{StaticResource DashboardCardProgressBarStyle}"
                                    IsIndeterminate="{Binding DashboardAutoCompressionProgressIsIndeterminate}"
                                    Value="{Binding DashboardAutoCompressionProgressValue}"
                                    Visibility="{Binding DashboardAutoCompressionProgressVisibility}" />
                                <SymbolIcon Grid.Column="1" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Symbol="Forward" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Button>

                <Button x:Name="DashboardSettingsButton" Grid.Row="1" Grid.Column="2" MinHeight="188" HorizontalAlignment="Stretch" AutomationProperties.Name="{Binding Texts.NavSettings}" Style="{StaticResource DashboardCardButtonStyle}" Click="DashboardCardButton_Click" Tag="settings" ToolTipService.ToolTip="{Binding Texts.NavSettings}">
                    <Grid RowSpacing="{StaticResource AppSpacingL}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Background="{ThemeResource ThemeModuleToolsSoftBrush}" Style="{StaticResource DashboardModuleIconBadgeStyle}">
                            <Viewbox Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <SymbolIcon Symbol="Setting" Foreground="{ThemeResource ThemeModuleToolsBrush}" />
                            </Viewbox>
                        </Border>

                        <StackPanel Grid.Row="1" Spacing="{StaticResource AppSpacingS}">
                            <TextBlock FontFamily="{StaticResource AppDisplayFont}" FontSize="{StaticResource AppHeadlineFontSize}" FontWeight="SemiBold" Text="{Binding Texts.NavSettings}" TextWrapping="WrapWholeWords" />
                            <TextBlock Foreground="{ThemeResource SubtleTextBrush}" MaxLines="3" Text="{Binding Texts.DashboardSettingsCardDescription}" TextTrimming="CharacterEllipsis" TextWrapping="WrapWholeWords" />
                        </StackPanel>

                        <Grid Grid.Row="2" ColumnSpacing="{StaticResource AppSpacingM}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <SymbolIcon Grid.Column="1" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Symbol="Forward" />
                        </Grid>
                    </Grid>
                </Button>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
