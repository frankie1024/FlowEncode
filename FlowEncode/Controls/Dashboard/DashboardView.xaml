<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="FlowEncode.Controls.Dashboard.DashboardView"
    x:Name="RootView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <UserControl.Resources>
        <SolidColorBrush x:Key="ButtonRevealBackground" Color="{ThemeResource ThemeColorCard}" />
        <SolidColorBrush x:Key="ButtonRevealBackgroundPointerOver" Color="{ThemeResource ThemeColorCardAlt}" />
        <SolidColorBrush x:Key="ButtonRevealBackgroundPressed" Color="{ThemeResource ThemeColorHeroSecondary}" />
        <SolidColorBrush x:Key="ButtonRevealBorderBrush" Color="{ThemeResource ThemeColorBorderSubtle}" />
        <SolidColorBrush x:Key="ButtonRevealBorderBrushPointerOver" Color="{ThemeResource ThemeColorBorderSubtle}" />
        <SolidColorBrush x:Key="ButtonRevealBorderBrushPressed" Color="{ThemeResource ThemeColorBorderSubtle}" />
        <SolidColorBrush x:Key="ButtonForeground" Color="{ThemeResource ThemeColorTextPrimary}" />
        <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="{ThemeResource ThemeColorTextPrimary}" />
        <SolidColorBrush x:Key="ButtonForegroundPressed" Color="{ThemeResource ThemeColorTextPrimary}" />

        <Style x:Key="DashboardActivityIndicatorStyle" TargetType="Border">
            <Setter Property="Width" Value="10" />
            <Setter Property="Height" Value="10" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Background" Value="{ThemeResource AppSuccessBrush}" />
            <Setter Property="CornerRadius" Value="999" />
        </Style>

        <Style x:Key="DashboardCardProgressBarStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="4" />
            <Setter Property="Maximum" Value="1" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{ThemeResource QueueProgressFillBrush}" />
            <Setter Property="Background" Value="{ThemeResource QueueProgressSoftBrush}" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>

        <Style x:Key="DashboardCardButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonRevealStyle}">
            <Setter Property="Background" Value="{ThemeResource CardBrush}" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource ThemeBorderHeroBrush}" />
            <Setter Property="BorderThickness" Value="{StaticResource AppCardBorderThickness}" />
            <Setter Property="CornerRadius" Value="{StaticResource AppCardCornerRadius}" />
            <Setter Property="Padding" Value="{StaticResource AppCardPadding}" />
            <Setter Property="Shadow" Value="{StaticResource CardShadow}" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="ContentTransitions">
                <Setter.Value>
                    <TransitionCollection>
                        <EntranceThemeTransition FromVerticalOffset="20" />
                    </TransitionCollection>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer x:Name="DashboardScroller" VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="DashboardContentStack" Padding="{StaticResource AppPagePadding}" Spacing="{StaticResource AppSpacingXXL}">
            <Border x:Name="DashboardHeroCard" MinHeight="148" Padding="{StaticResource AppCardPadding}" Background="{ThemeResource HeroBrush}" BorderBrush="{ThemeResource ThemeBorderHeroBrush}" BorderThickness="{StaticResource AppCardBorderThickness}" CornerRadius="{StaticResource AppLargeCornerRadius}" Shadow="{StaticResource HeroShadow}" Translation="0,0,8">
                <Border.Transitions>
                    <TransitionCollection>
                        <EntranceThemeTransition FromVerticalOffset="20" />
                    </TransitionCollection>
                </Border.Transitions>
                <Grid x:Name="DashboardHeroGrid" ColumnSpacing="{StaticResource AppSpacingL}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel x:Name="DashboardHeaderPanel" HorizontalAlignment="Left" Spacing="{StaticResource AppSpacingXS}" VerticalAlignment="Center">
                        <TextBlock x:Name="DashboardHeaderTitle" HorizontalAlignment="Left" FontFamily="{StaticResource AppDisplayFont}" FontSize="{StaticResource AppDisplayFontSize}" FontWeight="SemiBold" Text="FlowEncode" TextWrapping="WrapWholeWords" />
                        <TextBlock HorizontalAlignment="Left" MaxWidth="760" Foreground="{ThemeResource SubtleTextBrush}" Text="{Binding Texts.DashboardDescription}" TextWrapping="WrapWholeWords" />
                    </StackPanel>

                    <Border x:Name="DashboardHeroIconFrame" Grid.Column="1" Width="136" Height="136" Padding="0" Background="Transparent" BorderThickness="0" CornerRadius="0">
                        <Image Stretch="Uniform" AutomationProperties.AccessibilityView="Raw">
                            <Image.Source>
                                <BitmapImage UriSource="ms-appx:///Assets/FlowEncodeHammer.png" />
                            </Image.Source>
                        </Image>
                    </Border>
                </Grid>
            </Border>

            <Grid x:Name="DashboardCardGrid" ColumnSpacing="{StaticResource AppSpacingL}" RowSpacing="{StaticResource AppSpacingL}" VerticalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="DashboardRow0" Height="Auto" />
                    <RowDefinition x:Name="DashboardRow1" Height="Auto" />
                    <RowDefinition x:Name="DashboardRow2" Height="Auto" />
                    <RowDefinition x:Name="DashboardRow3" Height="Auto" />
                    <RowDefinition x:Name="DashboardRow4" Height="Auto" />
                    <RowDefinition x:Name="DashboardRow5" Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="DashboardPrimaryColumn" Width="*" />
                    <ColumnDefinition x:Name="DashboardSecondaryColumn" Width="*" />
                    <ColumnDefinition x:Name="DashboardTertiaryColumn" Width="*" />
                </Grid.ColumnDefinitions>

                <Button x:Name="DashboardDemuxButton" Grid.Row="0" Grid.Column="0" MinHeight="188" HorizontalAlignment="Stretch" AutomationProperties.Name="{Binding Texts.NavBluRayDemux}" Style="{StaticResource DashboardCardButtonStyle}" Click="DashboardCardButton_Click" Tag="bluray-demux" ToolTipService.ToolTip="{Binding Texts.NavBluRayDemux}">
                    <Grid RowSpacing="{StaticResource AppSpacingL}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid ColumnSpacing="{StaticResource AppSpacingS}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Viewbox Width="28" Height="28" HorizontalAlignment="Left">
                                <SymbolIcon Symbol="Library" />
                            </Viewbox>

                            <Border Grid.Column="1" Style="{StaticResource DashboardActivityIndicatorStyle}" Visibility="{Binding DashboardBluRayDemuxActivityVisibility}" />
                        </Grid>

                        <StackPanel Grid.Row="1" Spacing="{StaticResource AppSpacingS}">
                            <TextBlock FontFamily="{StaticResource AppDisplayFont}" FontSize="{StaticResource AppHeadlineFontSize}" FontWeight="SemiBold" Text="{Binding Texts.NavBluRayDemux}" TextWrapping="WrapWholeWords" />
                            <TextBlock Foreground="{ThemeResource SubtleTextBrush}" MaxLines="3" Text="{Binding Texts.DashboardDemuxCardDescription}" TextTrimming="CharacterEllipsis" TextWrapping="WrapWholeWords" />
                        </StackPanel>

                        <Grid Grid.Row="2" ColumnSpacing="{StaticResource AppSpacingM}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ProgressBar
                                Style="{StaticResource DashboardCardProgressBarStyle}"
                                IsIndeterminate="{Binding DashboardBluRayDemuxProgressIsIndeterminate}"
                                Value="{Binding DashboardBluRayDemuxProgressValue}"
                                Visibility="{Binding DashboardBluRayDemuxActivityVisibility}" />
                            <SymbolIcon Grid.Column="1" Symbol="Forward" />
                        </Grid>
                    </Grid>
                </Button>

                <Button x:Name="DashboardVapourSynthButton" Grid.Row="0" Grid.Column="1" MinHeight="188" HorizontalAlignment="Stretch" AutomationProperties.Name="{Binding Texts.NavVapourSynthWorkspace}" Style="{StaticResource DashboardCardButtonStyle}" Click="DashboardCardButton_Click" Tag="vapoursynth-workspace" ToolTipService.ToolTip="{Binding Texts.NavVapourSynthWorkspace}">
                    <Grid RowSpacing="{StaticResource AppSpacingL}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Viewbox Width="28" Height="28" HorizontalAlignment="Left">
                            <SymbolIcon Symbol="Edit" />
                        </Viewbox>

                        <StackPanel Grid.Row="1" Spacing="{StaticResource AppSpacingS}">
                            <TextBlock FontFamily="{StaticResource AppDisplayFont}" FontSize="{StaticResource AppHeadlineFontSize}" FontWeight="SemiBold" Text="{Binding Texts.NavVapourSynthWorkspace}" TextWrapping="WrapWholeWords" />
                            <TextBlock Foreground="{ThemeResource SubtleTextBrush}" MaxLines="3" Text="{Binding Texts.DashboardVapourSynthCardDescription}" TextTrimming="CharacterEllipsis" TextWrapping="WrapWholeWords" />
                        </StackPanel>

                        <Grid Grid.Row="2" ColumnSpacing="{StaticResource AppSpacingM}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <SymbolIcon Grid.Column="1" Symbol="Forward" />
                        </Grid>
                    </Grid>
                </Button>

                <Button x:Name="DashboardVideoEncodeButton" Grid.Row="0" Grid.Column="2" MinHeight="188" HorizontalAlignment="Stretch" AutomationProperties.Name="{Binding Texts.NavOverview}" Style="{StaticResource DashboardCardButtonStyle}" Click="DashboardCardButton_Click" Tag="overview" ToolTipService.ToolTip="{Binding Texts.NavOverview}">
                    <Grid RowSpacing="{StaticResource AppSpacingL}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid ColumnSpacing="{StaticResource AppSpacingS}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Viewbox Width="28" Height="28" HorizontalAlignment="Left">
                                <SymbolIcon Symbol="Video" />
                            </Viewbox>

                            <Border Grid.Column="1" Style="{StaticResource DashboardActivityIndicatorStyle}" Visibility="{Binding DashboardOverviewActivityVisibility}" />
                        </Grid>

                        <StackPanel Grid.Row="1" Spacing="{StaticResource AppSpacingS}">
                            <TextBlock FontFamily="{StaticResource AppDisplayFont}" FontSize="{StaticResource AppHeadlineFontSize}" FontWeight="SemiBold" Text="{Binding Texts.NavOverview}" TextWrapping="WrapWholeWords" />
                            <TextBlock Foreground="{ThemeResource SubtleTextBrush}" MaxLines="3" Text="{Binding Texts.DashboardVideoEncodeCardDescription}" TextTrimming="CharacterEllipsis" TextWrapping="WrapWholeWords" />
                        </StackPanel>

                        <Grid Grid.Row="2" ColumnSpacing="{StaticResource AppSpacingM}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ProgressBar
                                Style="{StaticResource DashboardCardProgressBarStyle}"
                                IsIndeterminate="{Binding DashboardOverviewProgressIsIndeterminate}"
                                Value="{Binding DashboardOverviewProgressValue}"
                                Visibility="{Binding DashboardOverviewActivityVisibility}" />
                            <SymbolIcon Grid.Column="1" Symbol="Forward" />
                        </Grid>
                    </Grid>
                </Button>

                <Button x:Name="DashboardAudioButton" Grid.Row="1" Grid.Column="0" MinHeight="188" HorizontalAlignment="Stretch" AutomationProperties.Name="{Binding Texts.NavAudioProcessing}" Style="{StaticResource DashboardCardButtonStyle}" Click="DashboardCardButton_Click" Tag="audio-process" ToolTipService.ToolTip="{Binding Texts.NavAudioProcessing}">
                    <Grid RowSpacing="{StaticResource AppSpacingL}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid ColumnSpacing="{StaticResource AppSpacingS}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Viewbox Width="28" Height="28" HorizontalAlignment="Left">
                                <SymbolIcon Symbol="Audio" />
                            </Viewbox>

                            <Border Grid.Column="1" Style="{StaticResource DashboardActivityIndicatorStyle}" Visibility="{Binding DashboardAudioProcessingActivityVisibility}" />
                        </Grid>

                        <StackPanel Grid.Row="1" Spacing="{StaticResource AppSpacingS}">
                            <TextBlock FontFamily="{StaticResource AppDisplayFont}" FontSize="{StaticResource AppHeadlineFontSize}" FontWeight="SemiBold" Text="{Binding Texts.NavAudioProcessing}" TextWrapping="WrapWholeWords" />
                            <TextBlock Foreground="{ThemeResource SubtleTextBrush}" MaxLines="3" Text="{Binding Texts.DashboardAudioTranscodeCardDescription}" TextTrimming="CharacterEllipsis" TextWrapping="WrapWholeWords" />
                        </StackPanel>

                        <Grid Grid.Row="2" ColumnSpacing="{StaticResource AppSpacingM}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ProgressBar
                                Style="{StaticResource DashboardCardProgressBarStyle}"
                                IsIndeterminate="{Binding DashboardAudioProcessingProgressIsIndeterminate}"
                                Value="{Binding DashboardAudioProcessingProgressValue}"
                                Visibility="{Binding DashboardAudioProcessingActivityVisibility}" />
                            <SymbolIcon Grid.Column="1" Symbol="Forward" />
                        </Grid>
                    </Grid>
                </Button>

                <Button x:Name="DashboardAutoCompressionButton" Grid.Row="1" Grid.Column="1" MinHeight="188" HorizontalAlignment="Stretch" AutomationProperties.Name="{Binding Texts.NavAutoCompression}" Style="{StaticResource DashboardCardButtonStyle}" Click="DashboardCardButton_Click" Tag="auto-compress" ToolTipService.ToolTip="{Binding Texts.NavAutoCompression}">
                    <Grid RowSpacing="{StaticResource AppSpacingL}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid ColumnSpacing="{StaticResource AppSpacingS}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Viewbox Width="28" Height="28" HorizontalAlignment="Left">
                                <SymbolIcon Symbol="Play" />
                            </Viewbox>

                            <Border Grid.Column="1" Style="{StaticResource DashboardActivityIndicatorStyle}" Visibility="{Binding DashboardAutoCompressionActivityVisibility}" />
                        </Grid>

                        <StackPanel Grid.Row="1" Spacing="{StaticResource AppSpacingS}">
                            <TextBlock FontFamily="{StaticResource AppDisplayFont}" FontSize="{StaticResource AppHeadlineFontSize}" FontWeight="SemiBold" Text="{Binding Texts.NavAutoCompression}" TextWrapping="WrapWholeWords" />
                            <TextBlock Foreground="{ThemeResource SubtleTextBrush}" MaxLines="3" Text="{Binding Texts.DashboardAutoCompressionCardDescription}" TextTrimming="CharacterEllipsis" TextWrapping="WrapWholeWords" />
                        </StackPanel>

                        <Grid Grid.Row="2" ColumnSpacing="{StaticResource AppSpacingM}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ProgressBar
                                Style="{StaticResource DashboardCardProgressBarStyle}"
                                IsIndeterminate="{Binding DashboardAutoCompressionProgressIsIndeterminate}"
                                Value="{Binding DashboardAutoCompressionProgressValue}"
                                Visibility="{Binding DashboardAutoCompressionActivityVisibility}" />
                            <SymbolIcon Grid.Column="1" Symbol="Forward" />
                        </Grid>
                    </Grid>
                </Button>

                <Button x:Name="DashboardSettingsButton" Grid.Row="1" Grid.Column="2" MinHeight="188" HorizontalAlignment="Stretch" AutomationProperties.Name="{Binding Texts.NavSettings}" Style="{StaticResource DashboardCardButtonStyle}" Click="DashboardCardButton_Click" Tag="settings" ToolTipService.ToolTip="{Binding Texts.NavSettings}">
                    <Grid RowSpacing="{StaticResource AppSpacingL}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Viewbox Width="28" Height="28" HorizontalAlignment="Left">
                            <SymbolIcon Symbol="Setting" />
                        </Viewbox>

                        <StackPanel Grid.Row="1" Spacing="{StaticResource AppSpacingS}">
                            <TextBlock FontFamily="{StaticResource AppDisplayFont}" FontSize="{StaticResource AppHeadlineFontSize}" FontWeight="SemiBold" Text="{Binding Texts.NavSettings}" TextWrapping="WrapWholeWords" />
                            <TextBlock Foreground="{ThemeResource SubtleTextBrush}" MaxLines="3" Text="{Binding Texts.DashboardSettingsCardDescription}" TextTrimming="CharacterEllipsis" TextWrapping="WrapWholeWords" />
                        </StackPanel>

                        <Grid Grid.Row="2" ColumnSpacing="{StaticResource AppSpacingM}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <SymbolIcon Grid.Column="1" Symbol="Forward" />
                        </Grid>
                    </Grid>
                </Button>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
