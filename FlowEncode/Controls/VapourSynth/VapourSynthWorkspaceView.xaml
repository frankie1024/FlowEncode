<UserControl
    x:Class="FlowEncode.Controls.VapourSynth.VapourSynthWorkspaceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:shared="using:FlowEncode.Controls.Shared"
    xmlns:vm="using:FlowEncode.ViewModels"
    xmlns:vs="using:FlowEncode.Controls.VapourSynth"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Loaded="UserControl_Loaded">
    <Grid
        x:Name="WorkspaceRoot"
        Background="{ThemeResource WindowBackgroundBrush}">
        <Border
            Background="{ThemeResource CardBrush}"
            BorderBrush="{ThemeResource CardBorderBrush}"
            BorderThickness="{StaticResource AppCardBorderThickness}"
            CornerRadius="{StaticResource AppLargeCornerRadius}" />

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition x:Name="EditorRowDefinition" Height="*" />
                <RowDefinition Height="1" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <CommandBar
                x:Name="EditorCommandBar"
                Padding="10,8,10,8"
                Background="{ThemeResource CardBrush}"
                DefaultLabelPosition="Right"
                IsDynamicOverflowEnabled="True"
                OverflowButtonVisibility="Auto">
                <AppBarButton Click="OpenDocumentButton_Click" Label="{Binding Texts.VapourSynthOpenButton}">
                    <AppBarButton.Icon>
                        <SymbolIcon Symbol="OpenFile" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Click="SaveDocumentButton_Click" Label="{Binding Texts.SaveButton}">
                    <AppBarButton.Icon>
                        <SymbolIcon Symbol="Save" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Click="SaveDocumentAsButton_Click" Label="{Binding Texts.SaveAsButton}">
                    <AppBarButton.Icon>
                        <SymbolIcon Symbol="SaveLocal" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarSeparator />
                <AppBarButton Click="UndoButton_Click" Label="{Binding Texts.VapourSynthUndoButton}">
                    <AppBarButton.Icon>
                        <SymbolIcon Symbol="Undo" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Click="RedoButton_Click" Label="{Binding Texts.VapourSynthRedoButton}">
                    <AppBarButton.Icon>
                        <SymbolIcon Symbol="Redo" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarSeparator />
                <AppBarButton Click="FindButton_Click" Label="{Binding Texts.VapourSynthFindButton}">
                    <AppBarButton.Icon>
                        <SymbolIcon Symbol="Find" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Click="ReplaceButton_Click" Label="{Binding Texts.VapourSynthReplaceButton}">
                    <AppBarButton.Icon>
                        <SymbolIcon Symbol="Switch" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Click="GoToButton_Click" Label="{Binding Texts.VapourSynthGoToButton}">
                    <AppBarButton.Icon>
                        <SymbolIcon Symbol="Forward" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarSeparator />
                <AppBarButton x:Name="EncodeButton" Click="EncodeButton_Click" Label="{Binding Texts.VapourSynthEncodeButton}">
                    <AppBarButton.Icon>
                        <SymbolIcon Symbol="Video" />
                    </AppBarButton.Icon>
                    <AppBarButton.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F9" />
                    </AppBarButton.KeyboardAccelerators>
                </AppBarButton>
                <AppBarButton Click="PreviewButton_Click" Label="{Binding Texts.VapourSynthPreviewButton}">
                    <AppBarButton.Icon>
                        <SymbolIcon Symbol="Play" />
                    </AppBarButton.Icon>
                    <AppBarButton.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F5" />
                    </AppBarButton.KeyboardAccelerators>
                </AppBarButton>
            </CommandBar>

            <TabView
                x:Name="WorkspaceTabView"
                Grid.Row="1"
                Padding="8,0,8,0"
                Background="{ThemeResource CardBrush}"
                AddTabButtonClick="WorkspaceTabView_AddTabButtonClick"
                IsAddTabButtonVisible="True"
                SelectionChanged="WorkspaceTabView_SelectionChanged"
                TabCloseRequested="WorkspaceTabView_TabCloseRequested"
                TabItemsSource="{Binding Tabs}">
                <TabView.TabItemTemplate>
                    <DataTemplate x:DataType="vm:VapourSynthWorkspaceTabViewModel">
                        <TabViewItem ContextRequested="WorkspaceTabViewItem_ContextRequested" IsClosable="True" DoubleTapped="WorkspaceTabViewItem_DoubleTapped">
                            <TabViewItem.Header>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <SymbolIcon
                                        Symbol="Pin"
                                        Visibility="{Binding PinIconVisibility}" />
                                    <TextBlock Text="{Binding TabTitle}" />
                                </StackPanel>
                            </TabViewItem.Header>
                        </TabViewItem>
                    </DataTemplate>
                </TabView.TabItemTemplate>
            </TabView>

            <Border
                Grid.Row="2"
                Padding="16,4,16,6"
                Background="{ThemeResource CardAltBrush}"
                BorderBrush="{ThemeResource CardBorderBrush}"
                BorderThickness="0,1,0,1">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="4">
                        <TextBlock
                            FontFamily="{StaticResource AppDisplayFont}"
                            FontSize="{StaticResource AppCardTitleFontSize}"
                            FontWeight="SemiBold"
                            Text="{Binding DocumentTitle}"
                            TextWrapping="WrapWholeWords" />
                        <TextBlock
                            FontFamily="{StaticResource AppMonoFont}"
                            Foreground="{ThemeResource SubtleTextBrush}"
                            Text="{Binding DocumentPathText}"
                            TextWrapping="WrapWholeWords" />
                    </StackPanel>

                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Spacing="12">
                        <TextBlock
                            MaxWidth="560"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource AppMonoFont}"
                            Foreground="{ThemeResource SubtleTextBrush}"
                            Text="{Binding HeaderStatusText}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap" />
                        <Border
                            Padding="10,4"
                            VerticalAlignment="Center"
                            Background="{ThemeResource AppWarningSoftBrush}"
                            BorderBrush="{ThemeResource AppWarningBrush}"
                            BorderThickness="{StaticResource AppCardBorderThickness}"
                            CornerRadius="{StaticResource AppControlCornerRadius}"
                            Visibility="{Binding DirtyBadgeVisibility}">
                            <TextBlock
                                FontSize="{StaticResource AppCaptionFontSize}"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource AppWarningBrush}"
                                Text="{Binding Texts.VapourSynthModifiedBadge}" />
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="3" x:Name="EditorSurfaceHost" ColumnSpacing="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="LeftEditorColumnDefinition" Width="*" />
                    <ColumnDefinition x:Name="RightEditorColumnDefinition" Width="0" />
                </Grid.ColumnDefinitions>

                <vs:VapourSynthEditorPaneView x:Name="LeftEditorPane" />
                <vs:VapourSynthEditorPaneView
                    x:Name="RightEditorPane"
                    Grid.Column="1"
                    Visibility="Collapsed" />
            </Grid>

            <Border Grid.Row="4" Background="{ThemeResource CardBorderBrush}" />

            <shared:AnimatedExpander
                x:Name="LogExpander"
                Grid.Row="5"
                ContentMargin="0"
                HeaderPadding="16,4,8,4"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch">
                <shared:AnimatedExpander.HeaderContent>
                    <Grid MinHeight="32">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource AppDisplayFont}"
                            FontSize="{StaticResource AppBodyLargeFontSize}"
                            FontWeight="SemiBold"
                            Text="{Binding Texts.VapourSynthLogTitle}" />
                    </Grid>
                </shared:AnimatedExpander.HeaderContent>
                <shared:AnimatedExpander.BodyContent>
                    <Grid MinHeight="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="144" />
                        </Grid.RowDefinitions>

                        <Grid
                            Padding="16,4,16,4"
                            Background="{ThemeResource CardAltBrush}"
                            ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource SubtleTextBrush}"
                                Text="{Binding Texts.VapourSynthLogEmptyPlaceholder}"
                                TextTrimming="CharacterEllipsis" />

                            <Button
                                Grid.Column="1"
                                Padding="12,4"
                                Click="ClearLogButton_Click"
                                AutomationProperties.Name="{Binding Texts.VapourSynthClearLogButton}"
                                ToolTipService.ToolTip="{Binding Texts.VapourSynthClearLogButton}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <SymbolIcon Symbol="Delete" />
                                    <TextBlock Text="{Binding Texts.VapourSynthClearLogButton}" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <TextBox
                            x:Name="LogTextBox"
                            Grid.Row="1"
                            Padding="16,8,16,12"
                            AcceptsReturn="True"
                            Background="Transparent"
                            BorderThickness="0"
                            FontFamily="{StaticResource AppMonoFont}"
                            IsReadOnly="True"
                            IsSpellCheckEnabled="False"
                            MinHeight="0"
                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                            Text="{Binding LogText, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </Grid>
                </shared:AnimatedExpander.BodyContent>
            </shared:AnimatedExpander>
        </Grid>
    </Grid>
</UserControl>
