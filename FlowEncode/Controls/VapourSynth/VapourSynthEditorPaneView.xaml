<UserControl
    x:Class="FlowEncode.Controls.VapourSynth.VapourSynthEditorPaneView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{ThemeResource CardBrush}">
        <Border
            x:Name="EditorOverlay"
            Padding="28"
            Background="{ThemeResource CardAltBrush}"
            Visibility="Visible">
            <StackPanel MaxWidth="520" Spacing="14" VerticalAlignment="Center">
                <ProgressRing
                    x:Name="EditorLoadingProgressRing"
                    Width="32"
                    Height="32"
                    IsActive="True" />
                <TextBlock
                    FontFamily="{StaticResource AppDisplayFont}"
                    FontSize="28"
                    FontWeight="SemiBold"
                    Text="{Binding Texts.VapourSynthWorkspaceTitle}" />
                <TextBlock
                    x:Name="EditorOverlayTextBlock"
                    Text="{Binding WorkspaceStatusText}"
                    Visibility="{Binding WorkspaceStatusVisibility}"
                    TextWrapping="WrapWholeWords" />
                <Button
                    x:Name="RetryEditorButton"
                    Width="160"
                    AutomationProperties.Name="{Binding Texts.VapourSynthEditorRetryButton}"
                    Click="RetryEditorButton_Click"
                    ToolTipService.ToolTip="{Binding Texts.VapourSynthEditorRetryButton}"
                    Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource AppCommandIconTextSpacing}">
                        <SymbolIcon Symbol="Refresh" />
                        <TextBlock Text="{Binding Texts.VapourSynthEditorRetryButton}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <WebView2 x:Name="EditorWebView" Visibility="Collapsed" />
    </Grid>
</UserControl>
