<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="FlowEncode.Controls.Settings.SetupDependencyCardView"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FlowEncode.Controls.Settings">
    <Border Margin="0,0,0,16" Padding="{StaticResource AppCardPadding}" Background="{ThemeResource CardAltBrush}" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="{StaticResource AppCardBorderThickness}" CornerRadius="{StaticResource AppCardCornerRadius}">
        <StackPanel Spacing="{StaticResource AppSpacingM}">
            <Grid ColumnSpacing="{StaticResource AppSpacingL}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock FontFamily="{StaticResource AppDisplayFont}" FontSize="{StaticResource AppSubsectionTitleFontSize}" FontWeight="SemiBold" Text="{Binding Title}" VerticalAlignment="Center" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{StaticResource AppSpacingS}" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button Style="{StaticResource StandardButtonStyle}" Content="{Binding Module.Texts.JetpackPackagesButton, ElementName=Root}" Visibility="{Binding JetpackPackagesVisibility}" Click="JetpackPackagesButton_Click" />
                    <Button Style="{StaticResource StandardButtonStyle}" Content="{Binding Module.Texts.DeewComponentsDownloadButton, ElementName=Root}" Visibility="{x:Bind ResolveDeewDownloadVisibility(DeewDownloadVisibility, DataContext), Mode=OneWay}" IsEnabled="{Binding DeewComponentsDownloadEnabled}" ToolTipService.ToolTip="{Binding Module.Texts.DeewComponentsDownloadHint, ElementName=Root}" Click="DownloadDeewComponentsButton_Click" />
                    <Button Style="{StaticResource StandardButtonStyle}" Content="{Binding MoreActionText}" AutomationProperties.Name="{Binding MoreActionText}" Visibility="{Binding MoreActionsVisibility}" IsEnabled="{Binding AdvancedUpdateEnabled}" Click="MoreDependencyActionsButton_Click" />
                    <Border Background="Transparent" Visibility="{Binding SettingsPrimaryActionVisibility}">
                        <ToolTipService.ToolTip>
                            <ToolTip MaxWidth="420"><TextBlock Text="{Binding PrimaryActionToolTip}" TextWrapping="Wrap" /></ToolTip>
                        </ToolTipService.ToolTip>
                        <Button AutomationProperties.Name="{Binding PrimaryActionText}" Tag="{Binding Kind}" Click="InstallSetupDependencyButton_Click" IsEnabled="{Binding PrimaryActionEnabled}" IsHitTestVisible="{Binding PrimaryActionEnabled}" AutomationProperties.HelpText="{Binding PrimaryActionToolTip}" Style="{StaticResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource AppCommandIconTextSpacing}">
                                <SymbolIcon Symbol="Download" />
                                <TextBlock Text="{Binding PrimaryActionText}" />
                            </StackPanel>
                        </Button>
                    </Border>
                    <Border Background="Transparent" Visibility="{Binding UninstallVisibility}">
                        <ToolTipService.ToolTip>
                            <ToolTip MaxWidth="420"><TextBlock Text="{Binding UninstallToolTip}" TextWrapping="Wrap" /></ToolTip>
                        </ToolTipService.ToolTip>
                        <Button Style="{StaticResource StandardButtonStyle}" AutomationProperties.Name="{Binding Module.Texts.UninstallButton, ElementName=Root}"
                                AutomationProperties.HelpText="{Binding UninstallToolTip}" Tag="{Binding Kind}"
                                Click="UninstallSetupDependencyButton_Click" IsEnabled="{Binding UninstallActionEnabled}" IsHitTestVisible="{Binding UninstallActionEnabled}">
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource AppCommandIconTextSpacing}">
                                <SymbolIcon Symbol="Delete" />
                                <TextBlock Text="{Binding Module.Texts.UninstallButton, ElementName=Root}" />
                            </StackPanel>
                        </Button>
                    </Border>
                </StackPanel>
            </Grid>

            <Grid ColumnSpacing="{StaticResource AppSpacingS}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource AppSpacingS}" Visibility="{Binding ReadyBadgeVisibility}">
                    <SymbolIcon Symbol="Accept" Foreground="{ThemeResource AppSuccessBrush}" />
                    <TextBlock FontWeight="SemiBold" Foreground="{ThemeResource AppSuccessBrush}" Text="{Binding StatusTitle}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource AppSpacingS}" Visibility="{Binding WarningBadgeVisibility}">
                    <SymbolIcon Symbol="Sync" Foreground="{ThemeResource AppWarningBrush}" />
                    <TextBlock FontWeight="SemiBold" Foreground="{ThemeResource AppWarningBrush}" Text="{Binding StatusTitle}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource AppSpacingS}" Visibility="{Binding BlockedBadgeVisibility}">
                    <SymbolIcon Symbol="Important" Foreground="{ThemeResource AppErrorBrush}" />
                    <TextBlock FontWeight="SemiBold" Foreground="{ThemeResource AppErrorBrush}" Text="{Binding StatusTitle}" />
                </StackPanel>
                <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="{ThemeResource SubtleTextBrush}"
                           Text="{Binding InlineStatusText}" TextWrapping="WrapWholeWords" Visibility="{Binding InlineStatusVisibility}" />
            </Grid>

            <TextBlock Text="{Binding StatusText}" TextWrapping="WrapWholeWords" MaxLines="2" TextTrimming="CharacterEllipsis"
                       ToolTipService.ToolTip="{Binding StatusText}" Visibility="{Binding StatusTextVisibility}" />

            <TextBlock Foreground="{ThemeResource AppWarningBrush}" Text="{Binding WarningText}" TextWrapping="WrapWholeWords" Visibility="{Binding WarningVisibility}" />

            <Grid RowSpacing="{StaticResource AppSpacingS}" Visibility="{Binding ProgressVisibility}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Foreground="{ThemeResource SubtleTextBrush}" Text="{Binding InstallProgressText}" TextWrapping="WrapWholeWords" />
                <TextBlock Grid.Column="1" FontFamily="{StaticResource AppMonoFont}" Text="{Binding InstallProgressPercentText}" />
                <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Height="6" Foreground="{ThemeResource QueueProgressFillBrush}" Background="{ThemeResource QueueProgressSoftBrush}" Minimum="0" Maximum="100" Value="{Binding InstallProgressPercent}" IsIndeterminate="{Binding IsInstallIndeterminate}" />
            </Grid>

            <local:OtherVapourSynthPluginsView Visibility="{Binding OtherPluginsVisibility}"
                                               Module="{Binding Module, ElementName=Root}" />
        </StackPanel>
    </Border>
</UserControl>
