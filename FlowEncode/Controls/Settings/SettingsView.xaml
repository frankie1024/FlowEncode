<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="FlowEncode.Controls.Settings.SettingsView"
    x:Name="RootView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shared="using:FlowEncode.Controls.Shared"
    xmlns:vm="using:FlowEncode.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <ScrollViewer x:Name="SettingsScrollViewer" VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="ContentStack" Padding="{StaticResource AppPagePadding}" Spacing="{StaticResource AppSpacingL}">
            <Border Padding="{StaticResource AppCardPadding}" Background="{ThemeResource CardBrush}" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="{StaticResource AppCardBorderThickness}" CornerRadius="{StaticResource AppLargeCornerRadius}" DataContext="{Binding General}">
                <Grid x:Name="SettingsOverviewGrid" ColumnSpacing="{StaticResource AppSpacingXXL}" RowSpacing="{StaticResource AppSpacingL}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*" />
                        <ColumnDefinition x:Name="SettingsOverviewSecondaryColumn" Width="0.9*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="{StaticResource AppSpacingXS}">
                        <TextBlock FontFamily="{StaticResource AppDisplayFont}" FontSize="{StaticResource AppSectionTitleFontSize}" FontWeight="SemiBold" Text="{Binding Texts.SettingsTitle}" />
                        <TextBlock Foreground="{ThemeResource SubtleTextBrush}" Text="{Binding AppCurrentVersionText}" TextWrapping="WrapWholeWords" />
                        <TextBlock Foreground="{ThemeResource SubtleTextBrush}" Text="{Binding AppLatestVersionText}" TextWrapping="WrapWholeWords" Visibility="{Binding AppLatestVersionVisibility}" />
                    </StackPanel>

                    <StackPanel x:Name="SettingsActionPanel" Grid.Column="1" Orientation="Horizontal" Spacing="{StaticResource AppSpacingS}" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <ProgressRing Width="26" Height="26" IsActive="{Binding IsAppUpdateActionInProgress}" Visibility="{Binding AppUpdateProgressVisibility}" />
                        <Button MinWidth="132" Style="{StaticResource AccentButtonStyle}" AutomationProperties.Name="{Binding AppUpdateActionText}" Click="CheckUpdatesButton_Click" IsEnabled="{Binding CanExecuteAppUpdateAction}" ToolTipService.ToolTip="{Binding AppUpdateActionText}">
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource AppCommandIconTextSpacing}">
                                <SymbolIcon Symbol="{Binding AppUpdateActionIcon}" />
                                <TextBlock Text="{Binding AppUpdateActionText}" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource StandardButtonStyle}" AutomationProperties.Name="{Binding Texts.SetupGuideButton}" Click="OpenSetupGuideButton_Click" ToolTipService.ToolTip="{Binding Texts.SetupGuideButton}">
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource AppCommandIconTextSpacing}">
                                <SymbolIcon Symbol="Help" />
                                <TextBlock Text="{Binding Texts.SetupGuideButton}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <Grid x:Name="SettingsControlsGrid" Grid.Row="1" Grid.ColumnSpan="2" ColumnSpacing="{StaticResource AppSpacingL}" RowSpacing="{StaticResource AppSpacingM}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition x:Name="SettingsControlsSecondaryColumn" Width="*" />
                            <ColumnDefinition x:Name="SettingsControlsTertiaryColumn" Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border x:Name="SettingsSelectorsPanel" Padding="{StaticResource AppInsetPanelPadding}" Background="{ThemeResource CardAltBrush}" CornerRadius="{StaticResource AppCardCornerRadius}">
                            <StackPanel Spacing="{StaticResource AppSpacingM}">
                                <TextBlock FontFamily="{StaticResource AppDisplayFont}" FontSize="{StaticResource AppCardTitleFontSize}" FontWeight="SemiBold" Text="{Binding Texts.SettingsAppearanceAndLanguageTitle}" />
                                <ComboBox x:Name="ThemeSelectorComboBox" Header="{Binding Texts.ThemeHeader}" DisplayMemberPath="Label" ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding SelectedTheme, Mode=TwoWay}" SelectionChanged="ThemeSelectorComboBox_SelectionChanged" />
                                <ComboBox x:Name="LanguageSelectorComboBox" Header="{Binding Texts.LanguageHeader}" DisplayMemberPath="Label" ItemsSource="{Binding LanguageOptions}" SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}" SelectionChanged="LanguageSelectorComboBox_SelectionChanged" />
                            </StackPanel>
                        </Border>

                        <Border x:Name="SettingsTogglePanel" Grid.Column="1" Padding="{StaticResource AppInsetPanelPadding}" Background="{ThemeResource CardAltBrush}" CornerRadius="{StaticResource AppCardCornerRadius}">
                            <StackPanel Spacing="{StaticResource AppSpacingM}">
                                <TextBlock FontFamily="{StaticResource AppDisplayFont}" FontSize="{StaticResource AppCardTitleFontSize}" FontWeight="SemiBold" Text="{Binding Texts.SettingsBehaviorTitle}" />
                                <ToggleSwitch x:Name="PreferSystemEncodersToggle" Header="{Binding Texts.PreferSystemEncodersHeader}" IsOn="{Binding PreferSystemEncoders, Mode=TwoWay}" OffContent="{Binding Texts.ToggleOffLabel}" OnContent="{Binding Texts.ToggleOnLabel}" ToolTipService.ToolTip="{Binding Texts.PreferSystemEncodersTooltip}" Toggled="SettingsToggle_Toggled" />
                                <ToggleSwitch x:Name="AutoCheckUpdatesToggle" Header="{Binding Texts.AutoCheckUpdatesHeader}" IsOn="{Binding AutoCheckUpdatesOnStartup, Mode=TwoWay}" OffContent="{Binding Texts.ToggleOffLabel}" OnContent="{Binding Texts.ToggleOnLabel}" ToolTipService.ToolTip="{Binding Texts.AutoCheckUpdatesTooltip}" Toggled="SettingsToggle_Toggled" />
                            </StackPanel>
                        </Border>

                        <Border x:Name="SettingsWorkspacePanel" Grid.Column="2" Padding="{StaticResource AppInsetPanelPadding}" Background="{ThemeResource CardAltBrush}" CornerRadius="{StaticResource AppCardCornerRadius}">
                            <StackPanel Spacing="{StaticResource AppSpacingM}">
                                <TextBlock FontFamily="{StaticResource AppDisplayFont}" FontSize="{StaticResource AppCardTitleFontSize}" FontWeight="SemiBold" Text="{Binding Texts.SettingsWorkspaceAndMcpTitle}" />
                                <StackPanel Spacing="6">
                                    <TextBlock Text="{Binding Texts.WorkspaceDirectoryHeader}" />
                                    <Grid>
                                        <TextBox x:Name="WorkspaceRootPathTextBox" AutomationProperties.Name="{Binding Texts.WorkspaceDirectoryHeader}" IsReadOnly="True" Text="{Binding WorkspaceRootPath, Mode=TwoWay}" ToolTipService.ToolTip="{Binding WorkspaceRootPath}" Padding="10,5,78,5" MinHeight="36" />
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0" Spacing="2">
                                            <Button Width="30" Height="28" MinWidth="0" MinHeight="0" Padding="0" Background="Transparent" BorderThickness="0" AutomationProperties.Name="{Binding Texts.ChooseFolderButton}" ToolTipService.ToolTip="{Binding Texts.ChooseFolderButton}" Click="BrowseWorkspaceFolderButton_Click">
                                                <SymbolIcon Symbol="Folder" />
                                            </Button>
                                            <Button Width="30" Height="28" MinWidth="0" MinHeight="0" Padding="0" Background="Transparent" BorderThickness="0" AutomationProperties.Name="{Binding Texts.OpenWorkspaceFolderButton}" ToolTipService.ToolTip="{Binding Texts.OpenWorkspaceFolderButton}" Tag="{Binding WorkspaceRootPath}" Click="OpenTaggedFolderButton_Click">
                                                <SymbolIcon Symbol="OpenLocal" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ToggleSwitch x:Name="McpAutomationToggle" Header="{Binding Texts.McpEnableHeader}" IsOn="{Binding EnableMcpAutomation, Mode=TwoWay}" OffContent="{Binding Texts.ToggleOffLabel}" OnContent="{Binding Texts.ToggleOnLabel}" Toggled="McpAutomationToggle_Toggled" />
                                    <Button x:Name="McpHelpButton" Grid.Column="1" Width="32" Height="32" Padding="0" VerticalAlignment="Bottom" Visibility="Collapsed" AutomationProperties.Name="{Binding Texts.McpConnectionHelpHeader}" ToolTipService.ToolTip="{Binding Texts.McpConnectionHelpTooltip}">
                                        <SymbolIcon Symbol="Help" />
                                        <Button.Flyout>
                                            <Flyout x:Name="McpConnectionFlyout" Opening="McpConnectionFlyout_Opening" Placement="BottomEdgeAlignedRight">
                                                <StackPanel x:Name="McpHelpContent" Width="420" MaxWidth="420" Spacing="12">
                                                    <TextBlock FontWeight="SemiBold" Text="{Binding Texts.McpConnectionHelpHeader}" />
                                                    <TextBlock Text="{Binding Texts.McpConnectionHint}" TextWrapping="Wrap" />
                                                    <TextBox AutomationProperties.Name="{Binding Texts.McpConnectionConfigHeader}" Text="{Binding McpConnectionConfig}" IsReadOnly="True" FontFamily="{StaticResource AppMonoFont}" FontSize="12" TextWrapping="Wrap" MaxHeight="240" ScrollViewer.VerticalScrollBarVisibility="Auto" />
                                                    <Button x:Name="CopyMcpConfigButton" Click="CopyMcpConfigButton_Click" HorizontalAlignment="Left" AutomationProperties.Name="{Binding Texts.McpCopyConfigButton}">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <SymbolIcon Symbol="Copy" />
                                                            <TextBlock x:Name="McpCopyLabel" Text="{Binding Texts.McpCopyConfigButton}" AutomationProperties.LiveSetting="Polite" />
                                                        </StackPanel>
                                                    </Button>
                                                    <TextBlock x:Name="McpCopyErrorText" Visibility="Collapsed" TextWrapping="Wrap" Foreground="{ThemeResource AppErrorBrush}" AutomationProperties.LiveSetting="Polite" />
                                                </StackPanel>
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <Border Padding="{StaticResource AppCardPadding}" Background="{ThemeResource CardBrush}" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="{StaticResource AppCardBorderThickness}" CornerRadius="{StaticResource AppLargeCornerRadius}" DataContext="{Binding Dependencies}">
                <StackPanel Spacing="{StaticResource AppSpacingM}">
                    <Grid x:Name="SettingsDependencyHeaderGrid" ColumnSpacing="{StaticResource AppSpacingL}" RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="{StaticResource AppSpacingXS}">
                            <TextBlock FontFamily="{StaticResource AppDisplayFont}" FontSize="{StaticResource AppSubsectionTitleFontSize}" FontWeight="SemiBold" Text="{Binding Texts.EnvironmentAndDependenciesTitle}" />
                            <TextBlock Foreground="{ThemeResource SubtleTextBrush}" Text="{Binding EnvironmentCheckedAtText}" TextWrapping="WrapWholeWords" />
                            <TextBlock Foreground="{ThemeResource SubtleTextBrush}" Text="{Binding SetupGuideRemoteCheckedAtText}" TextWrapping="WrapWholeWords" />
                        </StackPanel>

                        <StackPanel x:Name="SettingsDependencyActions" Grid.Column="1" Orientation="Horizontal" Spacing="{StaticResource AppSpacingS}" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <ProgressRing Width="24" Height="24" IsActive="True" Visibility="{Binding SetupGuideActionProgressVisibility}" />
                            <Button Style="{StaticResource StandardButtonStyle}" AutomationProperties.Name="{Binding Texts.WriteSystemPathButton}" Click="WriteSystemPathButton_Click" IsEnabled="{Binding CanWriteSystemPath}">
                                <ToolTipService.ToolTip>
                                    <ToolTip MaxWidth="420"><TextBlock Text="{Binding Texts.SystemPathHint}" TextWrapping="Wrap" /></ToolTip>
                                </ToolTipService.ToolTip>
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource AppCommandIconTextSpacing}">
                                    <SymbolIcon Symbol="Permissions" />
                                    <TextBlock Text="{Binding Texts.WriteSystemPathButton}" />
                                </StackPanel>
                            </Button>
                            <ProgressRing Width="24" Height="24" IsActive="True" Visibility="{Binding SystemPathProgressVisibility}" />
                            <Button MinWidth="112" Style="{StaticResource StandardButtonStyle}" AutomationProperties.Name="{Binding SetupGuideRefreshActionText}" Click="RefreshSetupGuideButton_Click" IsEnabled="{Binding CanExecuteSetupGuideRefreshAction}" ToolTipService.ToolTip="{Binding SetupGuideRefreshActionText}">
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource AppCommandIconTextSpacing}">
                                    <SymbolIcon Symbol="Refresh" />
                                    <TextBlock Text="{Binding SetupGuideRefreshActionText}" />
                                </StackPanel>
                            </Button>
                            <Button MinWidth="156" Style="{StaticResource StandardButtonStyle}" AutomationProperties.Name="{Binding SetupGuideUpdateCheckActionText}" Click="CheckSetupDependencyUpdatesButton_Click" IsEnabled="{Binding CanExecuteSetupGuideUpdateCheckAction}" ToolTipService.ToolTip="{Binding SetupGuideUpdateCheckActionText}">
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource AppCommandIconTextSpacing}">
                                    <SymbolIcon Symbol="Find" />
                                    <TextBlock Text="{Binding SetupGuideUpdateCheckActionText}" />
                                </StackPanel>
                            </Button>

                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="SettingsPathStatusText" Text="{Binding SystemPathStatusText}" TextWrapping="WrapWholeWords" IsTextSelectionEnabled="True" AutomationProperties.LiveSetting="Polite" Visibility="Collapsed" />
                    <ItemsControl ItemsSource="{Binding SetupGuideCards}" IsEnabled="{Binding CanModifyDependencies}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SetupGuideCardViewModel">
                                <shared:AnimatedExpander Margin="{StaticResource AppBottomSpacingM}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" CollapsedCompleted="SetupGuideCardExpander_CollapsedCompleted" ContentMargin="0" IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
                                    <shared:AnimatedExpander.HeaderContent>
                                        <Grid ColumnSpacing="{StaticResource AppSpacingM}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock FontFamily="{StaticResource AppDisplayFont}" FontSize="{StaticResource AppCardTitleFontSize}" FontWeight="SemiBold" Text="{Binding Title}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Foreground="{ThemeResource SubtleTextBrush}" Text="{Binding ReadySummary}" VerticalAlignment="Center" />
                                        </Grid>
                                    </shared:AnimatedExpander.HeaderContent>
                                    <shared:AnimatedExpander.BodyContent>
                                        <StackPanel>
                                            <ItemsControl ItemsSource="{Binding Items}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:SetupGuideDependencyItemViewModel">
                                                        <Border Margin="{StaticResource AppBottomSpacingM}" Padding="{StaticResource AppInsetPanelPadding}" Background="{ThemeResource CardBrush}" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="{StaticResource AppCardBorderThickness}" CornerRadius="{StaticResource AppCardCornerRadius}">
                                                            <Grid RowSpacing="{StaticResource AppSpacingM}">
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="Auto" />
                                                                </Grid.RowDefinitions>

                                                                <Grid ColumnSpacing="{StaticResource AppSpacingL}">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>

                                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                                        <TextBlock FontFamily="{StaticResource AppDisplayFont}" FontSize="{StaticResource AppSubsectionTitleFontSize}" FontWeight="SemiBold" Text="{Binding Title}" VerticalAlignment="Center" />
                                                                        <shared:ContextHelpButton Title="{Binding DataContext.Texts.PythonUpgradeHelpTitle, ElementName=RootView}" HelpText="{Binding UpgradeHelp}" VerticalAlignment="Center" />
                                                                    </StackPanel>

                                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{StaticResource AppSpacingS}" HorizontalAlignment="Right" VerticalAlignment="Top">
                                                                        <Button Content="{Binding MoreActionText}" AutomationProperties.Name="{Binding MoreActionText}" Visibility="{Binding MoreActionsVisibility}" IsEnabled="{Binding AdvancedUpdateEnabled}" Click="MoreDependencyActionsButton_Click" />
                                                                        <Border Background="Transparent" Visibility="{Binding SettingsPrimaryActionVisibility}">
                                                                            <ToolTipService.ToolTip>
                                                                                <ToolTip MaxWidth="420"><TextBlock Text="{Binding PrimaryActionToolTip}" TextWrapping="Wrap" /></ToolTip>
                                                                            </ToolTipService.ToolTip>
                                                                            <Button AutomationProperties.Name="{Binding PrimaryActionText}" Tag="{Binding Kind}" Click="InstallSetupDependencyButton_Click" IsEnabled="{Binding PrimaryActionEnabled}" IsHitTestVisible="{Binding PrimaryActionEnabled}" AutomationProperties.HelpText="{Binding PrimaryActionToolTip}" Style="{StaticResource AccentButtonStyle}">
                                                                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource AppCommandIconTextSpacing}">
                                                                                    <SymbolIcon Symbol="Download" />
                                                                                    <TextBlock Text="{Binding PrimaryActionText}" />
                                                                                </StackPanel>
                                                                            </Button>
                                                                        </Border>
                                                                        <Button AutomationProperties.Name="{Binding DataContext.Texts.UninstallButton, ElementName=RootView}" Tag="{Binding Kind}" Click="UninstallSetupDependencyButton_Click" IsEnabled="{Binding UninstallActionEnabled}" Visibility="{Binding UninstallVisibility}" ToolTipService.ToolTip="{Binding DataContext.Texts.UninstallTooltip, ElementName=RootView}">
                                                                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource AppCommandIconTextSpacing}">
                                                                                <SymbolIcon Symbol="Delete" />
                                                                                <TextBlock Text="{Binding DataContext.Texts.UninstallButton, ElementName=RootView}" />
                                                                            </StackPanel>
                                                                        </Button>

                                                                    </StackPanel>
                                                                </Grid>

                                                                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="{StaticResource AppSpacingS}" Visibility="{Binding ReadyBadgeVisibility}">
                                                                    <SymbolIcon Symbol="Accept" Foreground="{ThemeResource AppSuccessBrush}" />
                                                                    <TextBlock FontWeight="SemiBold" Foreground="{ThemeResource AppSuccessBrush}" Text="{Binding StatusTitle}" />
                                                                </StackPanel>

                                                                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="{StaticResource AppSpacingS}" Visibility="{Binding WarningBadgeVisibility}">
                                                                    <SymbolIcon Symbol="Sync" Foreground="{ThemeResource AppWarningBrush}" />
                                                                    <TextBlock FontWeight="SemiBold" Foreground="{ThemeResource AppWarningBrush}" Text="{Binding StatusTitle}" />
                                                                </StackPanel>

                                                                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="{StaticResource AppSpacingS}" Visibility="{Binding BlockedBadgeVisibility}">
                                                                    <SymbolIcon Symbol="Important" Foreground="{ThemeResource AppErrorBrush}" />
                                                                    <TextBlock FontWeight="SemiBold" Foreground="{ThemeResource AppErrorBrush}" Text="{Binding StatusTitle}" />
                                                                </StackPanel>

                                                                <StackPanel Grid.Row="2" Spacing="{StaticResource AppSpacingXS}">
                                                                    <TextBlock Text="{Binding StatusText}" TextWrapping="WrapWholeWords" />
                                                                    <TextBlock Foreground="{ThemeResource SubtleTextBrush}" Text="{Binding InstalledVersionText}" TextWrapping="WrapWholeWords" Visibility="{Binding InstalledVersionVisibility}" />
                                                                    <TextBlock Foreground="{ThemeResource SubtleTextBrush}" Text="{Binding LatestVersionText}" TextWrapping="WrapWholeWords" Visibility="{Binding LatestVersionVisibility}">
                                                                        <ToolTipService.ToolTip><ToolTip MaxWidth="420"><TextBlock Text="{Binding RecommendedVersionHelp}" TextWrapping="Wrap" /></ToolTip></ToolTipService.ToolTip>
                                                                    </TextBlock>
                                                                </StackPanel>

                                                                <TextBlock Grid.Row="3" Foreground="{ThemeResource AppWarningBrush}" Text="{Binding WarningText}" TextWrapping="WrapWholeWords" Visibility="{Binding WarningVisibility}" />

                                                                <Grid Grid.Row="4" RowSpacing="{StaticResource AppSpacingS}" Visibility="{Binding ProgressVisibility}">
                                                                    <Grid.RowDefinitions>
                                                                        <RowDefinition Height="Auto" />
                                                                        <RowDefinition Height="Auto" />
                                                                    </Grid.RowDefinitions>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>

                                                                    <TextBlock Foreground="{ThemeResource SubtleTextBrush}" Text="{Binding InstallProgressText}" TextWrapping="WrapWholeWords" />
                                                                    <TextBlock Grid.Column="1" FontFamily="{StaticResource AppMonoFont}" Text="{Binding InstallProgressPercentText}" />
                                                                    <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Height="6" Foreground="{ThemeResource QueueProgressFillBrush}" Background="{ThemeResource QueueProgressSoftBrush}" Minimum="0" Maximum="100" Value="{Binding InstallProgressPercent}" IsIndeterminate="{Binding IsInstallIndeterminate}" />
                                                                </Grid>

                                                                <TextBlock Grid.Row="5" FontFamily="{StaticResource AppMonoFont}" FontSize="{StaticResource AppCaptionFontSize}" Foreground="{ThemeResource SubtleTextBrush}" Text="{Binding ExecutablePath}" TextWrapping="WrapWholeWords" Visibility="{Binding PathVisibility}" />

                                                                <TextBlock Grid.Row="6" FontFamily="{StaticResource AppMonoFont}" FontSize="{StaticResource AppCaptionFontSize}" Foreground="{ThemeResource SubtleTextBrush}" Text="{Binding DetailText}" TextWrapping="WrapWholeWords" Visibility="{Binding DetailVisibility}" />
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </shared:AnimatedExpander.BodyContent>
                                </shared:AnimatedExpander>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
