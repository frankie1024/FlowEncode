<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="FlowEncode.Controls.Settings.SetupGuideOverlayView"
    x:Name="RootView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:settings="using:FlowEncode.Controls.Settings"
    xmlns:shared="using:FlowEncode.Controls.Shared"
    xmlns:vm="using:FlowEncode.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    IsTabStop="True">
        <Grid>
        <Border Background="{ThemeResource AppModalSmokeBrush}" />
        <Border
            x:Name="SetupGuideDialogCard"
            Margin="{StaticResource AppCardPadding}"
            MaxWidth="1160"
                Padding="{StaticResource AppDialogPadding}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{ThemeResource ModalCardBrush}"
                BorderBrush="{ThemeResource ThemeBorderElevatedBrush}"
                BorderThickness="{StaticResource AppCardBorderThickness}"
                CornerRadius="{StaticResource AppLargeCornerRadius}"
                shared:UiElevation.Level="E3">
                <Grid RowSpacing="{StaticResource AppSpacingL}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid x:Name="SetupGuideHeaderPanel" ColumnSpacing="{StaticResource AppSpacingL}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="{StaticResource AppSpacingS}">
                            <TextBlock FontFamily="{StaticResource AppDisplayFont}" FontSize="{StaticResource AppTitleFontSize}" FontWeight="SemiBold" Text="{Binding Texts.SetupGuideTitle}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{StaticResource AppSpacingS}" VerticalAlignment="Top">
                            <ProgressRing Width="24" Height="24" IsActive="True" Visibility="{Binding SetupGuideActionProgressVisibility}" />
                            <Button Style="{StaticResource StandardButtonStyle}" AutomationProperties.Name="{Binding SetupGuideRefreshActionText}" Click="RefreshSetupGuideButton_Click" IsEnabled="{Binding CanExecuteSetupGuideRefreshAction}" ToolTipService.ToolTip="{Binding SetupGuideRefreshActionText}">
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource AppCommandIconTextSpacing}">
                                    <SymbolIcon Symbol="Refresh" />
                                    <TextBlock Text="{Binding SetupGuideRefreshActionText}" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource StandardButtonStyle}" AutomationProperties.Name="{Binding SetupGuideUpdateCheckActionText}" Click="CheckSetupDependencyUpdatesButton_Click" IsEnabled="{Binding CanExecuteSetupGuideUpdateCheckAction}" ToolTipService.ToolTip="{Binding SetupGuideUpdateCheckActionText}">
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource AppCommandIconTextSpacing}">
                                    <SymbolIcon Symbol="Find" />
                                    <TextBlock Text="{Binding SetupGuideUpdateCheckActionText}" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="SetupGuideCloseButton" AutomationProperties.Name="{Binding Texts.SetupGuideCloseButton}" Click="CloseSetupGuideButton_Click" Style="{StaticResource AccentButtonStyle}" ToolTipService.ToolTip="{Binding Texts.SetupGuideCloseButton}">
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource AppCommandIconTextSpacing}">
                                    <SymbolIcon Symbol="Forward" />
                                    <TextBlock Text="{Binding Texts.SetupGuideCloseButton}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <FlipView
                        x:Name="SetupGuideFlipView"
                        Grid.Row="1"
                        VerticalAlignment="Top"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        ItemsSource="{Binding SetupGuideCards}"
                        SelectedIndex="{Binding SelectedSetupGuideCardIndex, Mode=TwoWay}"
                        SelectionChanged="SetupGuideFlipView_SelectionChanged">
                        <FlipView.ItemTemplate>
                            <DataTemplate x:DataType="vm:SetupGuideCardViewModel">
                                <Grid x:Name="SetupGuideCardContent" Margin="{StaticResource AppSetupGuideCarouselCardMargin}" RowSpacing="{StaticResource AppSpacingL}" VerticalAlignment="Stretch">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <StackPanel Spacing="{StaticResource AppSpacingS}">
                                            <TextBlock FontFamily="{StaticResource AppDisplayFont}" FontSize="{StaticResource AppHeadlineFontSize}" FontWeight="SemiBold" Text="{Binding Title}" />
                                        </StackPanel>

                                        <ScrollViewer Grid.Row="1" MinHeight="0" VerticalAlignment="Stretch" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                            <ItemsControl ItemsSource="{Binding Items}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:SetupGuideDependencyItemViewModel">
                                                        <settings:SetupDependencyCardView Module="{Binding DataContext, ElementName=RootView}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                </Grid>
                            </DataTemplate>
                        </FlipView.ItemTemplate>
                    </FlipView>

                    <Grid x:Name="SetupGuideFooterPanel" Grid.Row="2" HorizontalAlignment="Center" ColumnSpacing="{StaticResource AppSpacingL}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button
                            Style="{StaticResource ActionBarSecondaryButtonStyle}"
                            MinWidth="{StaticResource AppLargeCommandMinWidth}"
                            AutomationProperties.Name="{Binding Texts.SetupGuidePreviousButton}"
                            FontWeight="SemiBold"
                            Click="SetupGuidePreviousButton_Click"
                            IsEnabled="{Binding CanMoveSetupGuidePrevious}"
                            ToolTipService.ToolTip="{Binding Texts.SetupGuidePreviousButton}">
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource AppCommandIconTextSpacing}">
                                <SymbolIcon Symbol="Back" />
                                <TextBlock Text="{Binding Texts.SetupGuidePreviousButton}" />
                            </StackPanel>
                        </Button>

                        <TextBlock
                            Grid.Column="1"
                            Margin="{StaticResource AppInlineGapM}"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource AppMonoFont}"
                            FontSize="{StaticResource AppBodyFontSize}"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource SubtleTextBrush}"
                            Text="{Binding SetupGuidePositionText}"
                            Visibility="{Binding SetupGuidePositionVisibility}" />

                        <Button
                            Grid.Column="2"
                            Style="{StaticResource AccentActionButtonStyle}"
                            MinWidth="{StaticResource AppLargeCommandMinWidth}"
                            AutomationProperties.Name="{Binding SetupGuideForwardButtonText}"
                            FontWeight="SemiBold"
                            Click="SetupGuideNextButton_Click"
                            IsEnabled="{Binding CanAdvanceOrDismissSetupGuide}"
                            ToolTipService.ToolTip="{Binding SetupGuideForwardButtonText}">
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource AppCommandIconTextSpacing}">
                                <TextBlock Text="{Binding SetupGuideForwardButtonText}" />
                                <SymbolIcon Symbol="Forward" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
    </Grid>
</UserControl>
