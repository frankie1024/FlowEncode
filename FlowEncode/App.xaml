<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="FlowEncode.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FlowEncode"
    xmlns:shared="using:FlowEncode.Controls.Shared">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="Resources/ThemeResources.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <FontFamily x:Key="AppDisplayFont">XamlAutoFontFamily</FontFamily>
            <FontFamily x:Key="AppBodyFont">XamlAutoFontFamily</FontFamily>
            <FontFamily x:Key="AppMonoFont">Cascadia Code</FontFamily>
            <CornerRadius x:Key="AppLargeCornerRadius">8</CornerRadius>
            <CornerRadius x:Key="AppCardCornerRadius">8</CornerRadius>
            <CornerRadius x:Key="AppControlCornerRadius">4</CornerRadius>
            <Thickness x:Key="AppCardBorderThickness">1</Thickness>
            <Thickness x:Key="AppLargeCommandPadding">16,0</Thickness>
            <x:Double x:Key="AppLargeCommandMinWidth">136</x:Double>
            <x:Double x:Key="AppLargeCommandMinHeight">36</x:Double>
            <x:Double x:Key="AppLargeCommandFontSize">14</x:Double>
            <x:Double x:Key="AppButtonMinHeight">32</x:Double>
            <Thickness x:Key="AppButtonPadding">12,0</Thickness>
            <Thickness x:Key="AppAccentButtonPadding">16,0</Thickness>
            <x:Double x:Key="AppAccentButtonMinHeight">36</x:Double>
            <x:Double x:Key="AppIconButtonMinWidth">32</x:Double>
            <x:Double x:Key="AppIconButtonMinHeight">32</x:Double>
            <Thickness x:Key="AppIconButtonPadding">6</Thickness>
            <x:Double x:Key="AppCaptionFontSize">12</x:Double>
            <x:Double x:Key="AppSectionTitleFontSize">20</x:Double>
            <x:Double x:Key="AppSubsectionTitleFontSize">20</x:Double>
            <x:Double x:Key="AppCardTitleFontSize">18</x:Double>
            <x:Double x:Key="AppCommandIconTextSpacing">8</x:Double>
            <x:Double x:Key="AppDisplayFontSizeCompact">28</x:Double>

            <!-- Spacing tokens (4px base grid, Fluent Design) -->
            <x:Double x:Key="AppSpacingXS">4</x:Double>
            <x:Double x:Key="AppSpacingS">8</x:Double>
            <x:Double x:Key="AppSpacingM">12</x:Double>
            <x:Double x:Key="AppSpacingL">16</x:Double>
            <x:Double x:Key="AppSpacingXL">20</x:Double>
            <x:Double x:Key="AppSpacingXXL">24</x:Double>
            <x:Double x:Key="AppSpacingXXXL">32</x:Double>
            <Thickness x:Key="AppPagePadding">20,16,20,16</Thickness>
            <Thickness x:Key="AppCardPadding">16</Thickness>
            <Thickness x:Key="AppInsetPanelPadding">12</Thickness>
            <Thickness x:Key="AppDialogPadding">24</Thickness>
            <Thickness x:Key="AppBottomSpacingS">0,0,0,8</Thickness>
            <Thickness x:Key="AppBottomSpacingM">0,0,0,12</Thickness>
            <Thickness x:Key="AppInlineGapM">12,0</Thickness>
            <Thickness x:Key="AppSetupGuideCarouselCardMargin">4,0,16,0</Thickness>

            <!-- Font size tokens (Windows 11 Type Ramp) -->
            <x:Double x:Key="AppTitleLargeFontSize">40</x:Double>
            <x:Double x:Key="AppDisplayFontSize">32</x:Double>
            <x:Double x:Key="AppTitleFontSize">28</x:Double>
            <x:Double x:Key="AppHeadlineFontSize">20</x:Double>
            <x:Double x:Key="AppBodyLargeFontSize">18</x:Double>
            <x:Double x:Key="AppBodyFontSize">14</x:Double>
            <x:Double x:Key="AppSmallFontSize">12</x:Double>

            <!-- Elevation Z translation tokens live in ThemeResources.xaml (ThemeElevationZ_E1..E3). -->
            <x:Double x:Key="ElevationZ_E0">0</x:Double>

            <!-- Motion tokens (single source for custom UI animation durations, ms) -->
            <x:Double x:Key="MotionFast">120</x:Double>
            <x:Double x:Key="MotionNormal">180</x:Double>
            <x:Double x:Key="MotionEmphasis">240</x:Double>
            <x:Double x:Key="MotionSlow">320</x:Double>

            <!-- Motion easing tokens: enter EaseOut, exit EaseIn, size/position EaseInOut -->
            <CubicEase x:Key="MotionEasingEnter" EasingMode="EaseOut" />
            <CubicEase x:Key="MotionEasingExit" EasingMode="EaseIn" />
            <CubicEase x:Key="MotionEasingInOut" EasingMode="EaseInOut" />

            <!-- Motion geometry tokens -->
            <x:Double x:Key="MotionFieldOffsetY">8</x:Double>
            <x:Double x:Key="MotionHoverLiftY">2</x:Double>
            <x:Double x:Key="MotionListInsertOffsetY">8</x:Double>

            <Style TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            </Style>

            <Style x:Key="StandardButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="MinHeight" Value="{StaticResource AppButtonMinHeight}" />
                <Setter Property="Padding" Value="{StaticResource AppButtonPadding}" />
                <Setter Property="CornerRadius" Value="{StaticResource AppControlCornerRadius}" />
            </Style>

            <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource StandardButtonStyle}">
                <Setter Property="MinWidth" Value="{StaticResource AppIconButtonMinWidth}" />
                <Setter Property="MinHeight" Value="{StaticResource AppIconButtonMinHeight}" />
                <Setter Property="Padding" Value="{StaticResource AppIconButtonPadding}" />
            </Style>

            <Style x:Key="ActionBarSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource StandardButtonStyle}">
                <Setter Property="MinHeight" Value="{StaticResource AppAccentButtonMinHeight}" />
                <Setter Property="Padding" Value="{StaticResource AppAccentButtonPadding}" />
            </Style>

            <Style x:Key="AccentActionButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
                <Setter Property="MinHeight" Value="{StaticResource AppAccentButtonMinHeight}" />
                <Setter Property="Padding" Value="{StaticResource AppAccentButtonPadding}" />
                <Setter Property="CornerRadius" Value="{StaticResource AppControlCornerRadius}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
