<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="FlowEncode.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FlowEncode">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="Resources/ThemeResources.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <FontFamily x:Key="AppDisplayFont">Segoe UI Variable Display</FontFamily>
            <FontFamily x:Key="AppBodyFont">Segoe UI Variable Text</FontFamily>
            <FontFamily x:Key="AppMonoFont">Cascadia Code</FontFamily>
            <CornerRadius x:Key="AppLargeCornerRadius">12</CornerRadius>
            <CornerRadius x:Key="AppCardCornerRadius">8</CornerRadius>
            <CornerRadius x:Key="AppControlCornerRadius">6</CornerRadius>
            <Thickness x:Key="AppCardBorderThickness">1</Thickness>
            <Thickness x:Key="AppLargeCommandPadding">28,0</Thickness>
            <x:Double x:Key="AppLargeCommandMinWidth">180</x:Double>
            <x:Double x:Key="AppLargeCommandMinHeight">64</x:Double>
            <x:Double x:Key="AppLargeCommandFontSize">22</x:Double>
            <x:Double x:Key="AppCaptionFontSize">13</x:Double>
            <x:Double x:Key="AppSectionTitleFontSize">24</x:Double>
            <x:Double x:Key="AppSubsectionTitleFontSize">22</x:Double>
            <x:Double x:Key="AppCardTitleFontSize">20</x:Double>
            <x:Double x:Key="AppCommandIconTextSpacing">8</x:Double>
            <x:Double x:Key="AppDisplayFontSizeCompact">34</x:Double>

            <!-- Spacing tokens (4px base grid, Fluent Design) -->
            <x:Double x:Key="AppSpacingXS">4</x:Double>
            <x:Double x:Key="AppSpacingS">8</x:Double>
            <x:Double x:Key="AppSpacingM">12</x:Double>
            <x:Double x:Key="AppSpacingL">16</x:Double>
            <x:Double x:Key="AppSpacingXL">20</x:Double>
            <x:Double x:Key="AppSpacingXXL">24</x:Double>
            <x:Double x:Key="AppSpacingXXXL">32</x:Double>
            <Thickness x:Key="AppPagePadding">24,20,24,24</Thickness>
            <Thickness x:Key="AppCardPadding">20</Thickness>
            <Thickness x:Key="AppInsetPanelPadding">16</Thickness>
            <Thickness x:Key="AppDialogPadding">24</Thickness>
            <Thickness x:Key="AppBottomSpacingS">0,0,0,8</Thickness>
            <Thickness x:Key="AppBottomSpacingM">0,0,0,12</Thickness>
            <Thickness x:Key="AppInlineGapM">12,0</Thickness>
            <Thickness x:Key="AppSetupGuideCarouselCardMargin">4,0,16,0</Thickness>

            <!-- Font size tokens (Windows 11 Type Ramp) -->
            <x:Double x:Key="AppTitleLargeFontSize">40</x:Double>
            <x:Double x:Key="AppDisplayFontSize">38</x:Double>
            <x:Double x:Key="AppTitleFontSize">28</x:Double>
            <x:Double x:Key="AppHeadlineFontSize">26</x:Double>
            <x:Double x:Key="AppBodyLargeFontSize">18</x:Double>
            <x:Double x:Key="AppBodyFontSize">14</x:Double>
            <x:Double x:Key="AppSmallFontSize">12</x:Double>

            <!-- Shadow (Fluent Design elevation) -->
            <ThemeShadow x:Key="CardShadow" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
